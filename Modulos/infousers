#!/bin/bash
# infousers - Relatório de usuários SSH/OpenVPN/Dropbear/V2Ray

set -u
shopt -s nullglob

clear

DB_USERS="/root/usuarios.db"
PASS_DIR="/etc/SSHPlus/senha"
EXP_FILE="/etc/SSHPlus/Exp"

echo -e "\E[44;1;37m USUÁRIO        SENHA       LIMITE      VALIDADE \E[0m"
echo ""

# compat: alguns scripts antigos removem /bin/menu se não existir /bin/versao
[[ ! -e /bin/versao ]] && rm -rf /bin/menu >/dev/null 2>&1 || true

# garante DB existir (sem quebrar)
[[ -f "$DB_USERS" ]] || touch "$DB_USERS" >/dev/null 2>&1 || true

get_limit() {
  local u="$1"
  local lim
  lim="$(awk -v user="$u" '$1==user{print $2; found=1} END{if(!found) print "1"}' "$DB_USERS" 2>/dev/null)"
  [[ -z "${lim:-}" ]] && lim="1"
  echo "$lim"
}

get_pass() {
  local u="$1"
  if [[ -f "${PASS_DIR}/${u}" ]]; then
    cat "${PASS_DIR}/${u}" 2>/dev/null
  else
    echo "Null"
  fi
}

get_expire_display() {
  local u="$1"
  local exp_line exp_epoch now_epoch dat dias_rest

  # pega exatamente "Account expires"
  exp_line="$(chage -l "$u" 2>/dev/null | awk -F': ' '/^Account expires/ {print $2; exit}')"
  [[ -z "${exp_line:-}" ]] && { echo -e "\033[1;33mNunca\033[0m"; return; }

  if [[ "$exp_line" == "never" ]]; then
    echo -e "\033[1;33mNunca\033[0m"
    return
  fi

  exp_epoch="$(date -d "$exp_line" +%s 2>/dev/null || echo "")"
  now_epoch="$(date +%s)"

  if [[ -z "${exp_epoch:-}" ]]; then
    # se não converter, mostra cru
    echo -e "\033[1;33m${exp_line}\033[0m"
    return
  fi

  if (( now_epoch >= exp_epoch )); then
    echo -e "\033[1;31mVenceu\033[0m"
  else
    dias_rest=$(( (exp_epoch - now_epoch) / 86400 ))
    echo -e "${dias_rest} \033[1;37mDias\033[0m"
  fi
}

# Lista usuários "reais" (uid>900) sem nobody/polkitd/system-*
awk -F: '$3>900 {print $1}' /etc/passwd \
  | sort \
  | grep -v -E '^(nobody)$' \
  | grep -viE 'polkitd|system-' \
  | while read -r users; do

    lim="$(get_limit "$users")"
    senha="$(get_pass "$users")"
    data="$(get_expire_display "$users")"

    Usuario=$(printf ' %-15s' "$users")
    Senha=$(printf '%-13s' "$senha")
    Limite=$(printf '%-10s' "$lim")

    echo -e "\033[1;33m$Usuario \033[1;37m$Senha \033[1;37m$Limite \033[1;32m$data\033[0m"
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
done

# ==========================
# CONTAGEM DE ONLINES (ss/netstat fallback)
# ==========================
count_established_on_port() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -tan state established "( sport = :$port )" 2>/dev/null | tail -n +2 | wc -l
  else
    netstat -tan 2>/dev/null | awk -v p=":$port" '$6=="ESTABLISHED" && $4~p {c++} END{print c+0}'
  fi
}

_tuser=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)

_ons=0
_onop=0
_ondrp=0
_onv2ray=0

# SSH ports
SSH_PORTS="$(awk '/^\s*Port\s+/{print $2}' /etc/ssh/sshd_config 2>/dev/null | tr '\n' ' ')"
for port in $SSH_PORTS; do
  [[ -n "${port:-}" ]] || continue
  _ons=$(( _ons + $(count_established_on_port "$port") ))
done

# OpenVPN ports
if compgen -G "/etc/openvpn/*.conf" >/dev/null 2>&1; then
  OPENVPN_PORTS="$(awk '/^\s*port\s+/{print $2}' /etc/openvpn/*.conf 2>/dev/null | tr '\n' ' ')"
  for port in $OPENVPN_PORTS; do
    [[ -n "${port:-}" ]] || continue
    _onop=$(( _onop + $(count_established_on_port "$port") ))
  done
fi

# Dropbear: conta sessões (fallback simples)
if pgrep -x dropbear >/dev/null 2>&1; then
  # cada conexão geralmente vira um processo dropbear associado
  _ondrp="$(ps -C dropbear --no-headers 2>/dev/null | wc -l)"
  # tenta descontar 1 caso tenha master (varia)
  [[ "$_ondrp" -gt 0 ]] && _ondrp=$(( _ondrp - 1 )) || true
else
  _ondrp=0
fi

# V2Ray: ports do config (se existir)
for cfg in /etc/v2ray/config.json /usr/local/etc/v2ray/config.json; do
  if [[ -f "$cfg" ]]; then
    V2RAY_PORTS="$(grep -E '"port"\s*:' "$cfg" 2>/dev/null | awk '{print $2}' | tr -d ',"' | tr '\n' ' ')"
    for port in $V2RAY_PORTS; do
      [[ "$port" =~ ^[0-9]+$ ]] || continue
      _onv2ray=$(( _onv2ray + $(count_established_on_port "$port") ))
    done
    break
  fi
done

_onli=$(( _ons + _onop + _ondrp + _onv2ray ))
_expuser="$(cat "$EXP_FILE" 2>/dev/null || echo "0")"

echo -e "\033[1;33m• \033[1;36mTOTAL USUARIOS\033[1;37m $_tuser \033[1;33m• \033[1;32mONLINES\033[1;37m: $_onli \033[1;33m• \033[1;31mVENCIDOS\033[1;37m: $_expuser"

# ==========================
# LISTA V2RAY (RegV2ray / RegV2ray-*)
# ==========================
echo ""
echo -e "\E[44;1;37m USUÁRIO V2RAY         UUID         | USUÁRIO | VALIDADE \E[0m"
echo ""

vt=0
declare -A seen_uuids

for file in /etc/SSHPlus/RegV2ray /etc/SSHPlus/v2ray/RegV2ray-*; do
  [[ -f "$file" ]] || continue

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line// /}" ]] && continue

    uuid=""
    user=""
    datev=""

    if [[ "$line" == *"|"* ]]; then
      IFS='|' read -r uuid user datev <<< "$line"
    else
      # formato: user uuid date
      read -r user uuid datev <<< "$line"
    fi

    [[ -n "${user:-}" && -n "${uuid:-}" && -n "${datev:-}" ]] || continue
    [[ -z "${seen_uuids[$uuid]+x}" ]] || continue
    seen_uuids[$uuid]=1

    VPSsec="$(date +%s)"
    DataSec="$(date +%s --date="$datev" 2>/dev/null || echo 0)"

    if [[ "$DataSec" -eq 0 || "$VPSsec" -gt "$DataSec" ]]; then
      validade="\033[1;31mVenceu\033[0m"
    else
      dias_restantes=$(( (DataSec - VPSsec) / 86400 ))
      validade="$dias_restantes \033[1;37mDias\033[0m"
    fi

    Usuario=$(printf ' %-15s' "$user")
    UUID=$(printf '%-36s' "$uuid")

    echo -e "\033[1;33m$Usuario \033[1;37m$UUID \033[1;32m$validade\033[0m"
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"

    vt=$((vt + 1))
  done < "$file"
done

if [[ "$vt" -eq 0 ]]; then
  echo "Nenhum usuário V2Ray encontrado."
fi

echo ""
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;33m• \033[1;36mTOTAL USUARIOS\033[1;37m $vt \033[0m"
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"

echo -e "\033[1;37m• \033[1;33mENTER para retornar ao MENU!\033[0m"
read -r _

# volta pro menu se existir
if declare -F menu >/dev/null 2>&1; then
  menu
elif command -v menu >/dev/null 2>&1; then
  menu
else
  exit 0
fi
