#!/bin/bash
# MENU FERRAMENTAS - SSHPLUS (TITULO FUNDO 5;34;47 + BORDA AZUL 0;34)
# Mantém seu estilo e chama menu no final quando volta.

# ---------- FUNÇÕES AUXILIARES ----------
titulo_box() {
  local texto="${1^^}"
  local largura=70

  # linha azul
  printf "\033[0;34m%*s\033[0m\n" "$largura" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  # título com seu fundo (5;34;47) + negrito
  # centraliza dentro da largura
  local padding=$(( (largura - ${#texto}) / 2 ))
  local line
  line="$(printf "%*s%s%*s" "$padding" "" "$texto" "$padding" "")"
  # se a conta der ímpar, ajusta 1 espaço
  while [ ${#line} -lt $largura ]; do line="${line} "; done

  printf "\033[5;34;47m\033[1m%s\033[0m\n" "$line"

  # linha azul
  printf "\033[0;34m%*s\033[0m\n" "$largura" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

pause_enter() {
  echo -ne "\n\033[1;33mENTER \033[1;37mPARA VOLTAR AO MENU!\033[0m"
  read -r _
}

# ---------- FUNÇÃO PRINCIPAL DO MENU ----------
fun_ferramentas() {
  while true; do
    clear

    # TÍTULO (MAIÚSCULO/NEGRITO) + BORDA AZUL
