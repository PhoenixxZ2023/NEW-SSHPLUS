#!/bin/bash

BIN="/bin/badvpn-udpgw"
AUTOSTART="/etc/autostart"
DL_URL="https://raw.githubusercontent.com/PhoenixxZ2023/PLUS/main/Install/badvpn-udpgw"

is_running() {
  pgrep -f "badvpn-udpgw" >/dev/null 2>&1
}

list_ports() {
  if command -v ss >/dev/null 2>&1; then
    ss -lntp 2>/dev/null | awk '/badvpn-udpgw/ {print $4}' | awk -F: '{print $NF}' | sort -n | xargs
  else
    netstat -nplt 2>/dev/null | awk '/badvpn-udpgw/ {print $4}' | awk -F: '{print $NF}' | sort -n | xargs
  fi
}

ensure_bin() {
  if [[ -x "$BIN" ]]; then
    return 0
  fi

  mkdir -p "$(dirname "$BIN")" >/dev/null 2>&1 || true

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$DL_URL" -o "$BIN" || return 1
  else
    wget -q "$DL_URL" -O "$BIN" || return 1
  fi

  chmod 755 "$BIN" || return 1
  return 0
}

add_autostart_line() {
  local line="$1"
  touch "$AUTOSTART" >/dev/null 2>&1 || true
  grep -Fqx "$line" "$AUTOSTART" 2>/dev/null || echo "$line" >> "$AUTOSTART"
}

remove_autostart_udpvpn() {
  [[ -f "$AUTOSTART" ]] || return 0
  sed -i '/badvpn-udpgw/d; /screen -dmS udpvpn/d; /udpvpn/d' "$AUTOSTART" 2>/dev/null || true
}

stop_badvpn_all() {
  # mata screens udpvpn
  for sid in $(screen -ls 2>/dev/null | awk '/\.udpvpn/ {print $1}'); do
    screen -S "$sid" -X quit >/dev/null 2>&1 || true
  done
  screen -wipe >/dev/null 2>&1 || true

  # mata qualquer badvpn-udpgw restante
  pkill -f "badvpn-udpgw" >/dev/null 2>&1 || true

  remove_autostart_udpvpn
}

start_single_port() {
  local port="$1"
  screen -dmS "udpvpn" "$BIN" --listen-addr "127.0.0.1:${port}" --max-clients 10000 --max-connections-for-client 8 --client-socket-sndbuf 10000 >/dev/null 2>&1
}

start_range_ports() {
  local port
  for port in {7100..7900..100}; do
    screen -dmS "udpvpn" "$BIN" --listen-addr "127.0.0.1:${port}" --max-clients 9000 --max-connections-for-client 8 --client-socket-sndbuf 10000 --udp-mtu 9000 >/dev/null 2>&1
  done
}

valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] || return 1
  (( $1 >= 1 && $1 <= 65535 )) || return 1
  return 0
}

fun_badvpn() {
  while true; do
    clear
    echo -e "\033[0;34m┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\033[0m"
    echo -e "\033[0;34m┃\E[44;1;37m            GERENCIAR BADVPN             \E[0m\033[0;34m┃"
    echo -e "\033[0;34m┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\033[0m"

    if is_running; then
      echo -e "\033[1;33mPORTAS\033[1;37m: \033[1;32m$(list_ports)\033[0m"
      status_icon="\033[1;32m◉\033[0m"
    else
      echo -e "\033[1;33mPORTAS\033[1;37m: \033[1;31mNENHUMA\033[0m"
      status_icon="\033[1;31m○\033[0m"
    fi

    echo ""
    echo -e "\E[38;5;196m|\E[38;5;33m01\E[38;5;196m|\033[1;37m➜ • \033[1;33mATIVAR/DESATIVAR BADVPN (PADRÃO 7300) $status_icon\033[0m"
    echo -e "\E[38;5;196m|\E[38;5;33m02\E[38;5;196m|\033[1;37m➜ • \033[1;33mATIVAR PORTAS BADVPN (7100-7900)\033[0m"
    echo -e "\E[38;5;196m|\E[38;5;33m03\E[38;5;196m|\033[1;37m➜ • \033[1;33mABRIR PORTA PERSONALIZADA\033[0m"
    echo -e "\E[38;5;196m|\E[38;5;33m00\E[38;5;196m|\033[1;37m➜ • \033[1;33mVOLTAR\033[0m"
    echo ""
    echo -ne "\033[1;32mO QUE DESEJA FAZER \033[1;33m?\033[1;37m "
    read -r resposta

    case "$resposta" in
      1)
        if is_running; then
          echo -e "\n\033[1;32mDESATIVANDO O BADVPN...\033[0m"
          stop_badvpn_all
          echo -e "\033[1;32mBADVPN DESATIVADO COM SUCESSO!\033[0m"
          sleep 1
        else
          echo -e "\n\033[1;32mATIVANDO BADVPN (7300)...\033[0m"
          ensure_bin || { echo -e "\033[1;31mFALHA AO INSTALAR BADVPN!\033[0m"; sleep 2; continue; }
          stop_badvpn_all
          start_single_port 7300

          # autostart (somente 7300)
          add_autostart_line "pgrep -f 'badvpn-udpgw.*127.0.0.1:7300' >/dev/null 2>&1 || screen -dmS udpvpn /bin/badvpn-udpgw --listen-addr 127.0.0.1:7300 --max-clients 10000 --max-connections-for-client 8 --client-socket-sndbuf 10000"
          echo -e "\033[1;32mBADVPN ATIVADO COM SUCESSO!\033[0m"
          sleep 1
        fi
        ;;
      2)
        echo -e "\n\033[1;32mATIVANDO PORTAS (7100-7900)...\033[0m"
        ensure_bin || { echo -e "\033[1;31mFALHA AO INSTALAR BADVPN!\033[0m"; sleep 2; continue; }
        # não persistimos no autostart por padrão (igual seu texto original)
        stop_badvpn_all
        start_range_ports
        echo -e "\n\033[1;33mOBS:\033[1;37m ESSAS PORTAS NÃO PERSISTEM APÓS REBOOT (POR PADRÃO).\033[0m"
        echo -e "\033[1;32mPORTAS BADVPN ATIVADAS!\033[0m"
        sleep 2
        ;;
      3)
        echo -ne "\n\033[1;32mQUAL PORTA DESEJA UTILIZAR \033[1;33m?\033[1;37m: "
        read -r porta
        if ! valid_port "$porta"; then
          echo -e "\n\033[1;31mPORTA INVÁLIDA! USE 1-65535.\033[0m"
          sleep 1.5
          continue
        fi
        echo -e "\n\033[1;32mABRINDO PORTA BADVPN $porta...\033[0m"
        ensure_bin || { echo -e "\033[1;31mFALHA AO INSTALAR BADVPN!\033[0m"; sleep 2; continue; }
        start_single_port "$porta"
        echo -e "\033[1;32mPORTA $porta ABERTA COM SUCESSO!\033[0m"
        sleep 1.5
        ;;
      0)
        # volta pro seu menu principal
        menu
        return
        ;;
      *)
        continue
        ;;
    esac
  done
}

fun_badvpn
