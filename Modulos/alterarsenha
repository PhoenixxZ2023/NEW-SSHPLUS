#!/bin/bash

DB_PASS_DIR="/etc/SSHPlus/senha"
AUDIT_LOG="/var/log/sshplus-audit.log"

mkdir -p "$DB_PASS_DIR" >/dev/null 2>&1
touch "$AUDIT_LOG" >/dev/null 2>&1 || true

pause_return() {
  echo -ne "\n\033[1;33mENTER \033[1;37mPARA VOLTAR AO MENU!\033[0m"
  read -r
  menu 2>/dev/null || exit 0
}

list_users_with_pass() {
  echo -e "\033[1;33mLISTA DE USUARIOS E SUAS SENHAS:\033[0m"
  echo ""

  _userT=$(awk -F: '$3>=1000 {print $1}' /etc/passwd \
    | grep -v '^nobody$' | grep -viE 'polkitd|system-' | sort)

  i=0
  unset _userPass
  while read -r _user; do
    [[ -n "$_user" ]] || continue
    i=$((i+1))
    _oP=$i
    [[ $i == [1-9] ]] && i=0$i && oP+=" 0$i"

    if [[ -e "$DB_PASS_DIR/$_user" ]]; then
      _senha="$(cat "$DB_PASS_DIR/$_user" 2>/dev/null)"
      [[ -z "$_senha" ]] && _senha="Null"
    else
      _senha="Null"
    fi

    suser=$(echo -e "\033[1;31m[\033[1;36m$i\033[1;31m] \033[1;37m- \033[1;32m$_user\033[0m")
    ssenha=$(echo -e "\033[1;33mSenha\033[1;37m: $_senha")
    printf '%-60s%s\n' "$suser" "$ssenha"

    _userPass+="\n${_oP}:${_user}"
  done <<< "${_userT}"

  num_user=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v '^nobody$' | wc -l)
}

select_user() {
  local prompt="$1"
  echo ""
  echo -ne "$prompt"
  read -r option

  user=$(echo -e "${_userPass}" | grep -F ":$option" | cut -d: -f2)

  if [[ -z "${option:-}" || -z "${user:-}" ]]; then
    tput setaf 7; tput setab 1; tput bold
    echo ""; echo "OPÇÃO / USUÁRIO VAZIO OU INVÁLIDO!"
    echo ""; tput sgr0
    pause_return
  fi

  if ! getent passwd "$user" >/dev/null 2>&1; then
    tput setaf 7; tput setab 1; tput bold
    echo ""; echo "O USUÁRIO $user NÃO EXISTE!"
    echo ""; tput sgr0
    pause_return
  fi
}

change_password() {
  echo ""
  echo -ne "\033[1;32mNOVA SENHA PARA \033[1;33m$user\033[1;37m: "
  read -rs password
  echo ""

  if [[ -z "${password:-}" || ${#password} -lt 4 ]]; then
    tput setaf 7; tput setab 1; tput bold
    echo ""; echo "SENHA VAZIA OU INVÁLIDA! (MÍNIMO 4 CARACTERES)"
    echo ""; tput sgr0
    pause_return
  fi

  echo "${user}:${password}" | chpasswd >/dev/null 2>&1

  # salva senha (padrão SSHPlus) com permissões
  install -d -m 700 "$DB_PASS_DIR" >/dev/null 2>&1
  printf '%s\n' "$password" > "$DB_PASS_DIR/$user"
  chmod 600 "$DB_PASS_DIR/$user" >/dev/null 2>&1

  # auditoria (não grava senha)
  printf '%s | ALTERAR_SENHA | user=%s | by=%s\n' \
    "$(date '+%F %T')" "$user" "$(whoami 2>/dev/null || echo root)" >> "$AUDIT_LOG" 2>/dev/null || true

  # desconectar sessões do usuário (mais seguro que pkill -f)
  if pgrep -u "$user" >/dev/null 2>&1; then
    tput setaf 7; tput setab 4; tput bold
    echo "USUÁRIO CONECTADO. DESCONECTANDO..."
    tput sgr0
    pkill -u "$user" >/dev/null 2>&1
  fi

  tput setaf 7; tput setab 4; tput bold
  echo ""
  echo "SENHA DO USUÁRIO $user ALTERADA COM SUCESSO!"
  echo ""
  tput sgr0
  pause_return
}

show_password() {
  echo ""
  echo -e "\033[1;33mATENÇÃO:\033[1;37m ISSO VAI EXIBIR A SENHA EM TELA."
  echo -ne "\033[1;32mCONFIRMA MOSTRAR SENHA DO USUÁRIO \033[1;33m$user\033[1;32m? \033[1;33m[s/n]:\033[1;37m "
  read -r confirm

  if [[ "$confirm" != "s" && "$confirm" != "S" ]]; then
    echo -e "\n\033[1;31mCANCELADO!\033[0m"
    pause_return
  fi

  if [[ -e "$DB_PASS_DIR/$user" ]]; then
    _senha="$(cat "$DB_PASS_DIR/$user" 2>/dev/null)"
    [[ -z "$_senha" ]] && _senha="Null"
  else
    _senha="Null"
  fi

  # auditoria (não grava senha)
  printf '%s | MOSTRAR_SENHA | user=%s | by=%s\n' \
    "$(date '+%F %T')" "$user" "$(whoami 2>/dev/null || echo root)" >> "$AUDIT_LOG" 2>/dev/null || true

  clear
  tput setaf 7; tput setab 4; tput bold; printf '%35s%s%-10s\n' "SENHA DO USUÁRIO"; tput sgr0
  echo ""
  echo -e "\033[1;32mUSUÁRIO:\033[1;37m $user"
  echo -e "\033[1;32mSENHA:\033[1;37m $_senha"
  echo ""
  pause_return
}

# =========================
# MENU DO MÓDULO
# =========================
while true; do
  clear
  tput setaf 7; tput setab 4; tput bold; printf '%35s%s%-10s\n' "ALTERAR SENHA"; tput sgr0
  echo ""
  echo -e "\033[1;31m[\033[1;36m1\033[1;31m]\033[1;33m ALTERAR SENHA"
  echo -e "\033[1;31m[\033[1;36m2\033[1;31m]\033[1;33m MOSTRAR SENHA"
  echo -e "\033[1;31m[\033[1;36m0\033[1;31m]\033[1;33m VOLTAR"
  echo ""
  echo -ne "\033[1;32mO QUE DESEJA FAZER\033[1;31m ?\033[1;37m : "
  read -r op

  case "$op" in
    1)
      clear
      list_users_with_pass
      select_user "\033[1;32mSELECIONE UM USUÁRIO \033[1;33m[\033[1;36m1\033[1;31m-\033[1;36m$num_user\033[1;33m]\033[1;37m: "
      change_password
      ;;
    2)
      clear
      list_users_with_pass
      select_user "\033[1;32mSELECIONE UM USUÁRIO \033[1;33m[\033[1;36m1\033[1;31m-\033[1;36m$num_user\033[1;33m]\033[1;37m: "
      show_password
      ;;
    0)
      menu 2>/dev/null || exit 0
      ;;
    *)
      echo -e "\n\033[1;31mOPÇÃO INVÁLIDA!\033[0m"
      sleep 1
      ;;
  esac
done
