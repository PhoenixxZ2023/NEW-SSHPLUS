#!/bin/bash
clear

ARQ="/etc/Plus-torrent"
CHAIN="PLUS_TORRENT"

get_ip() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL ipv4.icanhazip.com 2>/dev/null || echo "0.0.0.0"
  else
    wget -qO- ipv4.icanhazip.com 2>/dev/null || echo "0.0.0.0"
  fi
}

need_root() {
  [[ $EUID -eq 0 ]] || { echo -e "\n\033[1;31mERRO:\033[0m execute como root.\n"; exit 1; }
}

ensure_deps() {
  command -v iptables >/dev/null 2>&1 || {
    apt-get update -y >/dev/null 2>&1
    apt-get install -y iptables >/dev/null 2>&1
  }
  command -v ss >/dev/null 2>&1 || true
  command -v lsof >/dev/null 2>&1 || {
    apt-get update -y >/dev/null 2>&1
    apt-get install -y lsof >/dev/null 2>&1
  }
}

list_listen_ports_tcp() {
  # retorna portas TCP em LISTEN
  if command -v ss >/dev/null 2>&1; then
    ss -lntp 2>/dev/null | awk 'NR>1 {print $4}' | awk -F: '{print $NF}' | grep -E '^[0-9]+$' | sort -nu
  else
    lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {print $9}' | awk -F: '{print $NF}' | grep -E '^[0-9]+$' | sort -nu
  fi
}

apply_rules() {
  local vps_ip nic
  vps_ip="$(get_ip)"
  nic="$(ip -4 route ls | awk '/default/ {print $5; exit}')"

  # cria chain se não existir
  iptables -t filter -N "$CHAIN" 2>/dev/null || true

  # garante jump (OUTPUT e FORWARD se existir tráfego roteado)
  iptables -t filter -C OUTPUT  -j "$CHAIN" 2>/dev/null || iptables -t filter -A OUTPUT  -j "$CHAIN"
  iptables -t filter -C FORWARD -j "$CHAIN" 2>/dev/null || iptables -t filter -A FORWARD -j "$CHAIN"

  # limpa regras antigas dentro da chain
  iptables -t filter -F "$CHAIN" 2>/dev/null || true

  # (1) permitir conexões já estabelecidas
  iptables -t filter -A "$CHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN

  # (2) permitir DNS (tcp/udp 53) e DHCP (67/udp) se necessário
  iptables -t filter -A "$CHAIN" -p udp --dport 53 -j RETURN
  iptables -t filter -A "$CHAIN" -p tcp --dport 53 -j RETURN
  iptables -t filter -A "$CHAIN" -p udp --dport 67 -j RETURN

  # (3) permitir portas TCP em uso (LISTEN) para não quebrar serviços atuais
  while read -r p; do
    iptables -t filter -A "$CHAIN" -p tcp --dport "$p" -j RETURN
  done < <(list_listen_ports_tcp)

  # (4) bloquear portas clássicas de torrent (principal)
  iptables -t filter -A "$CHAIN" -p tcp --dport 6881:6889 -j REJECT --reject-with tcp-reset
  iptables -t filter -A "$CHAIN" -p udp --dport 6881:6889 -j DROP

  # (5) bloqueio adicional “best effort” (menos custoso que string)
  # bloqueia DHT/BT comuns em UDP alto? (opcional) — deixei OFF por segurança.
  # iptables -t filter -A "$CHAIN" -p udp --dport 1024:65535 -m hashlimit --hashlimit-name bt --hashlimit-above 200/second --hashlimit-burst 400 -j DROP

  # (6) por fim, deixa passar o resto
  iptables -t filter -A "$CHAIN" -j RETURN

  # salva script removível mínimo
  cat > "$ARQ" <<EOF
#!/bin/bash
# regras PLUS_TORRENT (geradas)
iptables -t filter -D OUTPUT  -j $CHAIN 2>/dev/null
iptables -t filter -D FORWARD -j $CHAIN 2>/dev/null
iptables -t filter -F $CHAIN 2>/dev/null
iptables -t filter -X $CHAIN 2>/dev/null
exit 0
EOF
  chmod 700 "$ARQ"

  echo -e "\n\033[1;32mBLOQUEIO TORRENT APLICADO!\033[0m"
  echo -e "\033[1;33mIP VPS:\033[1;37m $vps_ip \033[1;33m•\033[1;33m NIC:\033[1;37m ${nic:-?}\033[0m\n"
}

remove_rules() {
  if [[ -x "$ARQ" ]]; then
    "$ARQ" >/dev/null 2>&1 || true
    rm -f "$ARQ"
  else
    # fallback: tenta remover mesmo assim
    iptables -t filter -D OUTPUT  -j "$CHAIN" 2>/dev/null || true
    iptables -t filter -D FORWARD -j "$CHAIN" 2>/dev/null || true
    iptables -t filter -F "$CHAIN" 2>/dev/null || true
    iptables -t filter -X "$CHAIN" 2>/dev/null || true
  fi

  echo -e "\n\033[1;33mTORRENT LIBERADO!\033[0m"
  echo -e "\033[1;32mREGRAS REMOVIDAS COM SUCESSO!\033[0m\n"
}

# ===== main =====
need_root
ensure_deps

echo -e "\E[44;1;37m           FIREWALL BLOQUEIO TORRENT           \E[0m"
echo ""

if [[ -e "$ARQ" ]]; then
  read -p "$(echo -e "\033[1;32mDESEJA REMOVER REGRAS FIREWALL? \033[1;33m[s/n]:\033[1;37m") " -e -i n resp
  if [[ "$resp" =~ ^[sS]$ ]]; then
    remove_rules
    sleep 1
    menu
  else
    menu
  fi
else
  echo -e "\033[1;31m[\033[1;33m!\033[1;31m]\033[1;33m FUNÇÃO BETA — USE POR SUA CONTA EM RISCO\033[0m"
  echo ""
  read -p "$(echo -ne "\033[1;32mDESEJA APLICAR REGRAS FIREWALL? \033[1;33m[s/n]:\033[1;37m") " -e -i n resp
  if [[ "$resp" =~ ^[sS]$ ]]; then
    apply_rules
    sleep 2
    menu
  else
    menu
  fi
fi
