#!/bin/bash

fun_exp() {
(
  userexp=0
  mkdir -p /etc/SSHPlus

  while read -r _user; do
    exp_str="$(chage -l "$_user" 2>/dev/null | awk -F': ' '/Account expires/ {print $2}')"

    # Sem data = não vence
    [[ -z "$exp_str" || "$exp_str" == "never" ]] && continue

    exp_epoch="$(date -d "$exp_str" +%s 2>/dev/null || echo "")"
    [[ -z "$exp_epoch" ]] && continue

    now_epoch="$(date +%s)"

    if (( now_epoch > exp_epoch )); then
      userexp=$((userexp + 1))
    fi
  done < <(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody)

  printf "%02d\n" "$userexp" > /etc/SSHPlus/Exp
) &
}

fun_exp >/dev/null 2>&1
