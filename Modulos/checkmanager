#!/bin/bash
set -euo pipefail

# ==============================
#  CHECKUSER PORT MANAGER
#  SSHPLUS STYLE MENU
# ==============================

# ---- CONFIG ----
BIN_CHECKUSER="/bin/checkuser"
STATE_DIR="/etc/SSHPlus/checkuser"
PORTS_FILE="$STATE_DIR/ports"
SERVICE_DIR="/etc/systemd/system"

# Portas comuns do SSHPlus (se quiser bloquear para evitar conflito)
RESERVED_PORTS=(22 443 80 8080 3128 8443 1080)

# ---- CORES / ESTILO ----
BOLD="\033[1m"
RESET="\033[0m"
RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUEBG="\033[44;1;37m"
CYAN="\033[1;36m"
WHITE="\033[1;37m"

title() { echo -e "${BLUEBG} $(printf '%-46s' "${1^^}") ${RESET}"; }
warn()  { echo -e "${YELLOW}${BOLD}${1^^}${RESET}"; }
ok()    { echo -e "${GREEN}${BOLD}${1^^}${RESET}"; }
err()   { echo -e "${RED}${BOLD}${1^^}${RESET}"; }
pause() { echo -ne "${WHITE}${BOLD}ENTER PARA CONTINUAR...${RESET}"; read -r; }

# ---- ROOT CHECK ----
if [[ "${EUID}" -ne 0 ]]; then
  err "EXECUTE COMO ROOT"
  exit 1
fi

# ---- PREP STATE ----
mkdir -p "$STATE_DIR"
touch "$PORTS_FILE"

# ---- HELPERS ----
is_number() { [[ "${1:-}" =~ ^[0-9]+$ ]]; }

in_reserved_ports() {
  local p="$1"
  for rp in "${RESERVED_PORTS[@]}"; do
    [[ "$p" -eq "$rp" ]] && return 0
  done
  return 1
}

is_port_in_use() {
  local port="$1"
  # Prefer ss (mais comum)
  if command -v ss >/dev/null 2>&1; then
    ss -lntp 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$port$" && return 0 || return 1
  fi
  # Fallback lsof
  if command -v lsof >/dev/null 2>&1; then
    lsof -i :"$port" >/dev/null 2>&1 && return 0 || return 1
  fi
  # Último fallback netstat
  if command -v netstat >/dev/null 2>&1; then
    netstat -nltp 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$port$" && return 0 || return 1
  fi
  # Sem ferramentas -> não dá pra checar com segurança
  return 2
}

port_in_file() {
  local port="$1"
  grep -qx "$port" "$PORTS_FILE"
}

add_port_to_file() {
  local port="$1"
  port_in_file "$port" || echo "$port" >> "$PORTS_FILE"
}

del_port_from_file() {
  local port="$1"
  sed -i "/^${port}\$/d" "$PORTS_FILE" 2>/dev/null || true
}

service_path() {
  local port="$1"
  echo "${SERVICE_DIR}/checkuser${port}.service"
}

service_exists() {
  local port="$1"
  [[ -f "$(service_path "$port")" ]]
}

create_service() {
  local port="$1"
  local cmd="${BIN_CHECKUSER} --port ${port}"
  cat > "$(service_path "$port")" <<EOF
[Unit]
Description=CHECKUSER PORT ${port}
After=network.target

[Service]
Type=simple
ExecStart=${cmd}
Restart=always
RestartSec=2

# Hardening básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
EOF
}

start_service() {
  local port="$1"
  systemctl daemon-reload
  systemctl enable "checkuser${port}.service" >/dev/null 2>&1 || true
  systemctl restart "checkuser${port}.service"
}

stop_remove_service() {
  local port="$1"
  systemctl stop "checkuser${port}.service" >/dev/null 2>&1 || true
  systemctl disable "checkuser${port}.service" >/dev/null 2>&1 || true
  rm -f "$(service_path "$port")"
  systemctl daemon-reload
}

list_ports_pretty() {
  if [[ ! -s "$PORTS_FILE" ]]; then
    echo -e "${YELLOW}${BOLD}NENHUMA${RESET}"
    return
  fi
  sort -n "$PORTS_FILE" | xargs
}

validate_port() {
  local port="$1"
  if ! is_number "$port"; then
    err "PORTA INVALIDA (APENAS NUMEROS)"
    return 1
  fi
  if (( port < 1 || port > 65535 )); then
    err "PORTA FORA DO RANGE (1-65535)"
    return 1
  fi
  return 0
}

# ---- ACTIONS ----
add_proxy_port() {
  local port="$1"

  validate_port "$port" || return 1

  # Evita conflito (opcional, você pode remover esse bloco se quiser permitir)
  if in_reserved_ports "$port"; then
    warn "ESSA PORTA E COMUM NO SSHPLUS (22/443/80/8080/3128/8443/1080)."
    warn "SE ABRIR AQUI, PODE DAR CONFLITO."
    echo -ne "${WHITE}${BOLD}DESEJA CONTINUAR? [S/N]: ${RESET}"
    read -r resp
    [[ "${resp,,}" != "s" ]] && return 1
  fi

  # Checa binário
  if [[ ! -x "$BIN_CHECKUSER" ]]; then
    err "BINARIO NAO ENCONTRADO OU NAO EXECUTAVEL: $BIN_CHECKUSER"
    return 1
  fi

  # Checa se já está registrado
  if port_in_file "$port"; then
    warn "PORTA JA CADASTRADA: $port"
  fi

  # Checa uso da porta
  if is_port_in_use "$port"; then
    err "A PORTA $port JA ESTA EM USO"
    return 1
  fi

  # Cria/atualiza service
  create_service "$port"
  start_service "$port"
  add_port_to_file "$port"

  ok "PORTA $port ABERTA COM SUCESSO"
  return 0
}

del_proxy_port() {
  local port="$1"

  validate_port "$port" || return 1

  if ! service_exists "$port" && ! port_in_file "$port"; then
    warn "PORTA $port NAO ESTA CADASTRADA"
    return 1
  fi

  stop_remove_service "$port"
  del_port_from_file "$port"

  ok "PORTA $port FECHADA COM SUCESSO"
  return 0
}

show_menu() {
  clear
  title "CHECKUSER - GERENCIAR PORTAS"
  echo
  echo -e "${CYAN}${BOLD}PORTAS ATIVAS:${RESET} ${WHITE}$(list_ports_pretty)${RESET}"
  echo
  echo -e "${RED}${BOLD}[${CYAN}01${RED}]${WHITE} • ${YELLOW}${BOLD}ABRIR PORTA${RESET}"
  echo -e "${RED}${BOLD}[${CYAN}02${RED}]${WHITE} • ${YELLOW}${BOLD}FECHAR PORTA${RESET}"
  echo -e "${RED}${BOLD}[${CYAN}00${RED}]${WHITE} • ${YELLOW}${BOLD}VOLTAR AO MENU${RESET}"
  echo
  echo -ne "${GREEN}${BOLD}OPCAO${RESET} ${YELLOW}${BOLD}?${RESET} ${WHITE}"
  read -r option
  echo -e "${RESET}"

  case "$option" in
    1|01)
      echo -ne "${GREEN}${BOLD}DIGITE A PORTA:${RESET} ${WHITE}"
      read -r port
      echo -e "${RESET}"
      add_proxy_port "$port" || true
      pause
      ;;
    2|02)
      echo -ne "${GREEN}${BOLD}DIGITE A PORTA:${RESET} ${WHITE}"
      read -r port
      echo -e "${RESET}"
      del_proxy_port "$port" || true
      pause
      ;;
    0|00)
      clear
      menu
      ;;
    *)
      err "OPCAO INVALIDA"
      pause
      ;;
  esac
}

while true; do
  show_menu
done
