#!/bin/bash
shopt -s extglob

DB="/root/usuarios.db"
PASS_DIR="/etc/SSHPlus/senha"
EXP_FILE="/etc/SSHPlus/Exp"

# =========================
# Helpers
# =========================
rm_db_user() {
  local user="$1"
  [[ -e "$DB" ]] || touch "$DB"
  awk -v u="$user" '$1!=u{print}' "$DB" > /tmp/.usuarios.db.$$ && mv /tmp/.usuarios.db.$$ "$DB"
}

recalc_expired_count() {
  local now count=0
  now="$(date +%s)"

  mkdir -p "$(dirname "$EXP_FILE")" >/dev/null 2>&1 || true
  : > /etc/SSHPlus/Exp.list 2>/dev/null || true

  while IFS=: read -r u _ uid _ _ _ _; do
    [[ "$uid" -ge 1000 ]] || continue
    [[ "$u" =~ ^(nobody|ubuntu|lxd)$ ]] && continue

    exp_line="$(chage -l "$u" 2>/dev/null | awk -F': ' '/^Account expires/ {print $2; exit}')"
    [[ -z "$exp_line" || "$exp_line" == "never" ]] && continue

    exp_val="$(date -d "$exp_line" +%s 2>/dev/null)" || continue
    if (( exp_val < now )); then
      ((count++))
      echo "$u" >> /etc/SSHPlus/Exp.list 2>/dev/null || true
    fi
  done < /etc/passwd

  echo "$count" > "$EXP_FILE"
}

remove_ovp() {
  local user="$1" GROUPNAME="nogroup"

  [[ -e /etc/debian_version ]] && GROUPNAME="nogroup"
  [[ -e /etc/redhat-release ]] && GROUPNAME="nobody"

  cd /etc/openvpn/easy-rsa/ 2>/dev/null || return 0
  [[ -x ./easyrsa ]] || return 0

  ./easyrsa --batch revoke "$user" >/dev/null 2>&1 || true
  ./easyrsa gen-crl >/dev/null 2>&1 || true

  rm -f "pki/reqs/$user.req" "pki/private/$user.key" "pki/issued/$user.crt" >/dev/null 2>&1 || true

  rm -f /etc/openvpn/crl.pem >/dev/null 2>&1 || true
  cp /etc/openvpn/easy-rsa/pki/crl.pem /etc/openvpn/crl.pem >/dev/null 2>&1 || true
  chown nobody:"$GROUPNAME" /etc/openvpn/crl.pem >/dev/null 2>&1 || true

  [[ -e "$HOME/$user.ovpn" ]] && rm -f "$HOME/$user.ovpn" >/dev/null 2>&1 || true
  [[ -e "/var/www/html/openvpn/$user.zip" ]] && rm -f "/var/www/html/openvpn/$user.zip" >/dev/null 2>&1 || true
}

del_user_system() {
  local user="$1"
  # mata tudo do usuário (mais correto que pkill -f "user")
  pkill -KILL -u "$user" >/dev/null 2>&1 || true

  if command -v deluser >/dev/null 2>&1; then
    deluser --force "$user" >/dev/null 2>&1 || return 1
  else
    userdel --force "$user" >/dev/null 2>&1 || return 1
  fi

  return 0
}

# =========================
# UI Menu
# =========================
clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%32s%s%-13s\n' "Remover Usuário SSH" ; tput sgr0
echo ""
echo -e "\033[1;31m[\033[1;36m1\033[1;31m]\033[1;33m REMOVER UM USUARIO"
echo -e "\033[1;31m[\033[1;36m2\033[1;31m]\033[1;33m REMOVER TODOS USUARIOS"
echo -e "\033[1;31m[\033[1;36m3\033[1;31m]\033[1;33m VOLTAR"
echo ""

read -p "$(echo -e "\033[1;32mOQUE DESEJA FAZER\033[1;31m ?\033[1;37m : ")" -e -i 1 resp

if [[ "$resp" = "1" ]]; then
  clear
  tput setaf 7 ; tput setab 4 ; tput bold ; printf '%32s%s%-13s\n' "Remover Usuário SSH" ; tput sgr0
  echo ""
  echo -e "\033[1;33mLISTA DE USUARIOS: \033[0m"
  echo ""

  mapfile -t USERS < <(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -Ev '^(nobody|ubuntu|lxd)$')
  total="${#USERS[@]}"

  if (( total == 0 )); then
    echo -e "\n\033[1;31mNenhum usuário para remover.\033[0m"
    sleep 2
    menu
    exit 0
  fi

  for i in "${!USERS[@]}"; do
    n=$((i+1))
    printf "\033[1;31m[\033[1;36m%02d\033[1;31m] \033[1;37m- \033[1;32m%s\033[0m\n" "$n" "${USERS[$i]}"
  done

  echo ""
  echo -ne "\033[1;32mDigite ou selecione um usuario \033[1;33m[\033[1;36m1\033[1;31m-\033[1;36m$total\033[1;33m]\033[1;37m: "
  read -r option

  if [[ -z "${option:-}" || ! "$option" =~ ^[0-9]+$ || "$option" -lt 1 || "$option" -gt "$total" ]]; then
    tput setaf 7 ; tput setab 1 ; tput bold ; echo "" ; echo "  Usuario vazio ou inválido!   " ; echo "" ; tput sgr0
    exit 1
  fi

  user="${USERS[$((option-1))]}"

  if id "$user" >/dev/null 2>&1; then
    echo ""
    if del_user_system "$user"; then
      echo -e "\E[41;1;37m Usuario $user removido com sucesso! \E[0m"
      rm_db_user "$user"
      rm -f "$PASS_DIR/$user" >/dev/null 2>&1 || true

      if [[ -e /etc/openvpn/server.conf ]]; then
        remove_ovp "$user"
      fi

      recalc_expired_count
      exit 0
    else
      echo -e "\n\033[1;31mFalha ao remover o usuário $user.\033[0m"
      exit 1
    fi
  else
    tput setaf 7 ; tput setab 4 ; tput bold ; echo "" ; echo "O usuário $user não existe!" ; echo "" ; tput sgr0
    exit 1
  fi

elif [[ "$resp" = "2" ]]; then
  clear
  tput setaf 7 ; tput setab 4 ; tput bold ; printf '%32s%s%-13s\n' "Remover Usuário SSH" ; tput sgr0
  echo ""
  echo -ne "\033[1;33mREALMENTE DESEJA REMOVER TODOS USUARIOS \033[1;37m[s/n]: "
  read -r opc

  if [[ "$opc" = @(s|S) ]]; then
    echo -e "\n\033[1;33mAguarde\033[1;32m.\033[1;31m.\033[1;33m.\033[0m"

    while IFS=: read -r user _ uid _ _ _ _; do
      [[ "$uid" -ge 1000 ]] || continue
      [[ "$user" =~ ^(nobody|ubuntu|lxd)$ ]] && continue

      del_user_system "$user" >/dev/null 2>&1 || true
      rm -f "$PASS_DIR/$user" >/dev/null 2>&1 || true

      if [[ -e /etc/openvpn/server.conf ]]; then
        remove_ovp "$user"
      fi
    done < /etc/passwd

    : > "$DB" 2>/dev/null || true
    rm -f /root/*.zip >/dev/null 2>&1 || true

    recalc_expired_count

    echo -e "\n\033[1;32mUSUARIOS REMOVIDOS COM SUCESSO!\033[0m"
    sleep 2
    menu
  else
    echo -e "\n\033[1;31mRetornando ao menu...\033[0m"
    sleep 2
    menu
  fi

elif [[ "$resp" = "3" ]]; then
  menu
else
  echo -e "\n\033[1;31mOpcao invalida !\033[0m"
  sleep 1.5s
  menu
fi
