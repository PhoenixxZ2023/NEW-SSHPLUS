YELLOW_BOLD='\033[1;33m'
GREEN_BOLD='\033[1;32m'
RED_BOLD='\033[1;31m'
WHITE_BOLD='\033[1;37m'
RESET='\033[0m'

box_top()    { echo -e "${BLUE_BOLD}╭━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╮${RESET}"; }
box_mid()    { echo -e "${BLUE_BOLD}┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫${RESET}"; }
box_bottom() { echo -e "${BLUE_BOLD}╰━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╯${RESET}"; }
box_title()  { printf "%b┃%b %s %b┃%b\n" "$BLUE_BOLD" "$WHITE_BOLD" "$(printf "%-57s" "${*^^}")" "$BLUE_BOLD" "$RESET"; }

sec()  { echo -e "${RED_BOLD}• ${GREEN_BOLD}${*^^}${RESET}"; }
kv()   { echo -e "${YELLOW_BOLD}${1^^}:${RESET} ${WHITE_BOLD}${2}${RESET}"; }
line() { echo -e "${BLUE_BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"; }

# ---- CPU usage robusto via /proc/stat (1s) ----
cpu_usage() {
  local idle_a total_a idle_b total_b
  read -r _ user nice sys idle iow irq sirq steal guest gnice < <(awk '/^cpu /{print $0; exit}' /proc/stat)
  idle_a=$((idle+iow))
  total_a=$((user+nice+sys+idle+iow+irq+sirq+steal+guest+gnice))
  sleep 1
  read -r _ user nice sys idle iow irq sirq steal guest gnice < <(awk '/^cpu /{print $0; exit}' /proc/stat)
  idle_b=$((idle+iow))
  total_b=$((user+nice+sys+idle+iow+irq+sirq+steal+guest+gnice))

  awk -v ia="$idle_a" -v ib="$idle_b" -v ta="$total_a" -v tb="$total_b" 'BEGIN{
    idle=ib-ia; total=tb-ta;
    if (total<=0) {print "0.0%"; exit}
    usage=(1-(idle/total))*100;
    printf "%.1f%%\n", usage
  }'
}

# ---- OS info (prioriza /etc/os-release) ----
os_info() {
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    kv "NOME" "${PRETTY_NAME:-DESCONHECIDO}"
    [[ -n "${ID:-}" ]] && kv "ID" "${ID}"
    [[ -n "${VERSION_ID:-}" ]] && kv "VERSÃO" "${VERSION_ID}"
    [[ -n "${ID_LIKE:-}" ]] && kv "DERIVADO DO OS" "${ID_LIKE}"
  elif [[ -f /etc/lsb-release ]]; then
    local name codename
    name="$(awk -F= '/^DISTRIB_DESCRIPTION=/{gsub(/"/,"",$2); print $2}' /etc/lsb-release)"
    codename="$(awk -F= '/^DISTRIB_CODENAME=/{gsub(/"/,"",$2); print $2}' /etc/lsb-release)"
    kv "NOME" "${name:-DESCONHECIDO}"
    [[ -n "${codename:-}" ]] && kv "CODENAME" "${codename}"
  else
    kv "NOME" "$(cat /etc/issue.net 2>/dev/null | head -n1)"
  fi

  kv "KERNEL" "$(uname -s)"
  kv "KERNEL RELEASE" "$(uname -r)"
  kv "ARQUITETURA" "$(uname -m)"
}

# ---- LISTEN ports: ss -> netstat fallback ----
list_listening() {
  if command -v ss >/dev/null 2>&1; then
    ss -lntp 2>/dev/null | awk '
      NR==1{next}
      $1=="LISTEN"{
        addr=$4
        gsub(/^\[|\]$/,"",addr)
        n=split(addr,a,":")
        port=a[n]
        proc=$0
        name="?"
        if (match(proc, /users:\(\("([^"]+)"/, m)) name=m[1]
        printf "%s|%s\n", name, port
      }' | sort -t'|' -k2,2n -u
    return 0
  fi

  if command -v netstat >/dev/null 2>&1; then
    netstat -lntp 2>/dev/null | awk '
      NR<=2{next}
      $6=="LISTEN"{
        addr=$4
        n=split(addr,a,":")
        port=a[n]
        name=$7
        sub(/\/.*/,"",name)
        if (name=="") name="?"
        printf "%s|%s\n", name, port
      }' | sort -t'|' -k2,2n -u
    return 0
  fi

  return 1
}

clear
box_top
box_title "INFORMAÇÕES DO VPS"
box_bottom
echo ""

sec "SISTEMA OPERACIONAL"
echo ""
os_info
echo ""
line
echo ""

sec "PROCESSADOR"
echo ""
if [[ -f /proc/cpuinfo ]]; then
  modelo="$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo)"
  cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null || grep -c '^processor' /proc/cpuinfo)"
  cache="$(awk -F': ' '/cache size/{print $2; exit}' /proc/cpuinfo)"
  kv "MODELO" "${modelo:-DESCONHECIDO}"
  kv "NÚCLEOS" "${cores:-?}"
  [[ -n "${cache:-}" ]] && kv "CACHE" "${cache}"
  kv "UTILIZAÇÃO" "$(cpu_usage)"
else
  echo -e "${RED_BOLD}${BOLD}NÃO FOI POSSÍVEL OBTER INFORMAÇÕES DO PROCESSADOR${RESET}"
fi
echo ""
line
echo ""

sec "MEMÓRIA RAM"
echo ""
if command -v free >/dev/null 2>&1; then
  ram_total="$(free -h | awk '/^Mem:/{print $2}')"
  ram_used="$(free -h | awk '/^Mem:/{print $3}')"
  ram_free="$(free -h | awk '/^Mem:/{print $4}')"
  ram_pct="$(free -m | awk '/^Mem:/{printf "%.2f%%", ($3*100)/$2}')"
  kv "TOTAL" "$ram_total"
  kv "EM USO" "$ram_used"
  kv "LIVRE" "$ram_free"
  kv "UTILIZAÇÃO" "$ram_pct"
else
  echo -e "${RED_BOLD}${WHITE_BOLD}COMANDO FREE NÃO DISPONÍVEL${RESET}"
fi
echo ""
line
echo ""

sec "TEMPO DE ATIVIDADE"
echo ""
tempo="$(uptime -p 2>/dev/null | sed 's/^up //')"
kv "SERVIDOR ATIVO HÁ" "${tempo:-DESCONHECIDO}"
echo ""
line
echo ""

sec "SERVIÇOS EM EXECUÇÃO (PORTAS EM LISTEN)"
echo ""
if [[ "$(id -u)" -ne 0 ]]; then
  echo -e "${YELLOW_BOLD}AVISO:${RESET} ${WHITE_BOLD}EXECUTE COMO ROOT PARA VER NOMES DE PROCESSOS COMPLETOS.${RESET}"
  echo ""
fi

if out="$(list_listening)"; then
  if [[ -z "${out:-}" ]]; then
    echo -e "${RED_BOLD}${WHITE_BOLD}NENHUMA PORTA EM LISTEN ENCONTRADA OU SEM PERMISSÃO.${RESET}"
  else
    while IFS='|' read -r svc port; do
      [[ -z "${port:-}" ]] && continue
      echo -e "${YELLOW_BOLD}SERVIÇO${RESET} ${WHITE_BOLD}${svc}${RESET}  ${YELLOW_BOLD}PORTA${RESET} ${WHITE_BOLD}${port}${RESET}"
    done <<< "$out"
  fi
else
  echo -e "${RED_BOLD}${WHITE_BOLD}NÃO FOI POSSÍVEL LISTAR PORTAS (SS/NETSTAT AUSENTE).${RESET}"
fi

echo ""
line
echo -ne "${YELLOW_BOLD}ENTER PARA VOLTAR AO MENU...${RESET}"
read -r
