#!/bin/bash
shopt -s extglob

IP="$(cat /etc/IP 2>/dev/null || echo "127.0.0.1")"

cor1='\033[41;1;37m'
cor2='\033[44;1;37m'
scor='\033[0m'

DB_USERS="/root/usuarios.db"
PASS_DIR="/etc/SSHPlus/senha"
EXP_FILE="/etc/SSHPlus/Exp"

# =========================
# DB sem duplicar (atualiza limite)
# =========================
db_upsert_limit() {
  local user="$1" limit="$2"
  mkdir -p "$(dirname "$DB_USERS")" >/dev/null 2>&1 || true
  touch "$DB_USERS"

  awk -v u="$user" -v l="$limit" '
    BEGIN{found=0}
    $1==u {print u, l; found=1; next}
    {print}
    END{if(!found) print u, l}
  ' "$DB_USERS" > /tmp/.usuarios.db.$$ && mv /tmp/.usuarios.db.$$ "$DB_USERS"
}

# =========================
# Recalcular EXP como NUMERO em /etc/SSHPlus/Exp
# (Opcional: lista em /etc/SSHPlus/Exp.list)
# =========================
recalc_expired_list() {
  mkdir -p "$(dirname "$EXP_FILE")" >/dev/null 2>&1 || true

  local now count=0
  now="$(date +%s)"

  : > /etc/SSHPlus/Exp.list 2>/dev/null || true

  while IFS=: read -r u _ uid _ _ _ _; do
    [[ "$uid" -ge 1000 ]] || continue
    [[ "$u" =~ ^(nobody|ubuntu|lxd)$ ]] && continue

    local exp_line exp_val
    exp_line="$(chage -l "$u" 2>/dev/null | awk -F': ' '/^Account expires/ {print $2; exit}')"
    [[ -z "$exp_line" ]] && continue
    [[ "$exp_line" == "never" ]] && continue

    exp_val="$(date -d "$exp_line" +%s 2>/dev/null)" || continue

    if (( exp_val < now )); then
      ((count++))
      echo "$u" >> /etc/SSHPlus/Exp.list 2>/dev/null || true
    fi
  done < /etc/passwd

  echo "$count" > "$EXP_FILE"
}

# =========================
# OpenVPN helpers
# =========================
newclient() {
  local user="$1"
  cp /etc/openvpn/client-common.txt "/root/${user}.ovpn"

  {
    echo "<ca>"
    cat /etc/openvpn/easy-rsa/pki/ca.crt
    echo "</ca>"
    echo "<cert>"
    cat "/etc/openvpn/easy-rsa/pki/issued/${user}.crt"
    echo "</cert>"
    echo "<key>"
    cat "/etc/openvpn/easy-rsa/pki/private/${user}.key"
    echo "</key>"
    echo "<tls-auth>"
    cat /etc/openvpn/ta.key
    echo "</tls-auth>"
  } >> "/root/${user}.ovpn"
}

fun_geraovpn() {
  cd /etc/openvpn/easy-rsa/ || return 1
  [[ -x ./easyrsa ]] || return 1

  ./easyrsa build-client-full "$username" nopass >/dev/null 2>&1 || return 1
  newclient "$username" || return 1

  if [[ "${respost:-n}" = @(s|S) ]]; then
    sed -e "s;auth-user-pass;<auth-user-pass>\n${username}\n${password}\n</auth-user-pass>;g" \
      "/root/${username}.ovpn" > "/root/tmp.ovpn" && mv -f "/root/tmp.ovpn" "/root/${username}.ovpn"
  fi

  return 0
}

# Ler info do OpenVPN (se existir)
if [[ -e /etc/openvpn/server.conf && -e /etc/openvpn/client-common.txt ]]; then
  _Port="$(awk '/^\s*port\s+/{print $2; exit}' /etc/openvpn/server.conf 2>/dev/null)"
  [[ -z "${_Port:-}" ]] && _Port="1194"

  hst="$(sed -n '8p' /etc/openvpn/client-common.txt 2>/dev/null | awk '{print $4}')"
  rmt2='/SSHPLUS?'
  rmt3='www.vivo.com.br 8088'
  prx='200.142.130.104'
  payload1='#payload "HTTP/1.0 [crlf]Host: m.youtube.com[crlf]CONNECT HTTP/1.0[crlf][crlf]|[crlf]"'
  payload2='#payload "CONNECT 127.0.0.1:1194[split][crlf] HTTP/1.0 [crlf][crlf]#"'

  vivo1="portalrecarga.vivo.com.br/recarga"
  vivo3="navegue.vivo.com.br/pre/"
  oi="d1n212ccp6ldpw.cloudfront.net"
  bypass="net_gateway"
  cert01="/etc/openvpn/client-common.txt"

  if [[ "$hst" == "$vivo1" ]]; then
    Host="Portal Recarga"
  elif [[ "$hst" == "$vivo3" ]]; then
    Host="Portal Navegue"
  elif [[ "$hst" == "$IP:${_Port}" ]]; then
    Host="Vivo MMS"
  elif [[ "$hst" == "$oi" ]]; then
    Host="Oi"
  elif [[ "$hst" == "$bypass" ]]; then
    Host="Modo Bypass"
  else
    Host="Customizado"
  fi
fi

fun_bar() {
  comando[0]="$1"
  comando[1]="${2:-true}"
  (
    [[ -e $HOME/fim ]] && rm -f "$HOME/fim"
    bash -c "${comando[0]}" >/dev/null 2>&1
    bash -c "${comando[1]}" >/dev/null 2>&1
    touch "$HOME/fim"
  ) >/dev/null 2>&1 &

  tput civis
  echo -ne "\033[1;33mAGUARDE \033[1;37m- \033[1;33m["
  while true; do
    for ((i=0; i<18; i++)); do
      echo -ne "\033[1;31m#"
      sleep 0.1s
    done
    [[ -e $HOME/fim ]] && rm -f "$HOME/fim" && break
    echo -e "\033[1;33m]"
    sleep 1s
    tput cuu1
    tput dl1
    echo -ne "\033[1;33mAGUARDE \033[1;37m- \033[1;33m["
  done
  echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
  tput cnorm
}

fun_edithost() {
  [[ -z "${_Port:-}" ]] && return 0
  clear
  echo -e "\E[44;1;37m          ALTERAR HOST OVPN            \E[0m"
  echo ""
  echo -e "\033[1;33mHOST EM USO\033[1;37m: \033[1;32m${Host:-Indefinido}"
  echo ""
  echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;33mVIVO RECARGA"
  echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;33mVIVO NAVEGUE PRE"
  echo -e "\033[1;31m[\033[1;36m0\033[1;31m] \033[1;33mVOLTAR"
  echo ""
  echo -ne "\033[1;32mQUAL HOST DESEJA ULTILIZAR \033[1;33m?\033[1;37m "
  read -r respo
  [[ -z "${respo:-}" ]] && { echo -e "\n\033[1;31mOpcao invalida!"; sleep 2; fun_edithost; }

  case "$respo" in
    1)
      fun_bar "sed -i '7,9d' '$cert01' && sed -i \"7i\\remote $rmt2 $_Port\\nhttp-proxy-option CUSTOM-HEADER Host $vivo1\\nhttp-proxy $IP 80\" '$cert01'"
      fun_geraovpn ;;
    2)
      fun_bar "sed -i '7,9d' '$cert01' && sed -i \"7i\\remote $rmt2 $_Port\\nhttp-proxy-option CUSTOM-HEADER Host $vivo3\\nhttp-proxy $IP 80\" '$cert01'"
      fun_geraovpn ;;
    0) return 0 ;;
    *) echo -e "\n\033[1;31mOpcao invalida !\033[0m"; sleep 2; fun_edithost ;;
  esac

  echo -e "\n\033[1;32mHOST/OVPN atualizado!\033[0m"
  sleep 1.2
}

# =========================
# UI
# =========================
clear
echo -e "\033[0;34m╭━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╮\033[0m"
echo -e "\033[0;34m┃\E[44;1;37m            CRIAR USUARIO SSH            \E[0m\033[0;34m┃"
echo -e "\033[0;34m╰━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╯\033[0m"
echo ""

echo -ne "\033[1;32m🗣️  USUÁRIO:\033[1;37m "
read -r username

if [[ -z "${username:-}" ]]; then
  echo -e "\n${cor1}usuário vazio ou invalido!${scor}\n"; exit 1
fi
if ! [[ "$username" =~ ^[a-zA-Z0-9._-]{2,25}$ ]]; then
  echo -e "\n${cor1}Usuário inválido! Use 2-25 chars: letras/números . _ -${scor}\n"; exit 1
fi
if id "$username" >/dev/null 2>&1; then
  echo -e "\n${cor1}Este usuário já existe. tente outro nome!${scor}\n"; exit 1
fi

echo -ne "\033[1;32m🔑 SENHA:\033[1;37m "
read -r password
if [[ -z "${password:-}" || ${#password} -lt 4 ]]; then
  echo -e "\n${cor1}Senha vazia ou curta! (min 4)${scor}\n"; exit 1
fi

echo -ne "\033[1;32m⌛ DIAS PARA EXPIRA:\033[1;37m "
read -r dias
if [[ -z "${dias:-}" || ! "$dias" =~ ^[0-9]+$ || "$dias" -lt 1 ]]; then
  echo -e "\n${cor1}Número de dias inválido!${scor}\n"; exit 1
fi

echo -ne "\033[1;32m📲 LIMITE DE CONEXÕES:\033[1;37m "
read -r sshlimiter
if [[ -z "${sshlimiter:-}" || ! "$sshlimiter" =~ ^[0-9]+$ || "$sshlimiter" -lt 1 ]]; then
  echo -e "\n${cor1}Limite inválido!${scor}\n"; exit 1
fi

final="$(date "+%Y-%m-%d" -d "+$dias days")"
gui="$(date "+%d/%m/%Y" -d "+$dias days")"

# cria usuário (sem mascarar erro)
if ! useradd -M -s /bin/false "$username" >/dev/null 2>&1; then
  echo -e "\n${cor1}Falha ao criar usuário!${scor}\n"
  exit 1
fi

# define senha e expiração
echo "${username}:${password}" | chpasswd
chage -E "$final" "$username" >/dev/null 2>&1 || true

# salva senha
mkdir -p "$PASS_DIR" >/dev/null 2>&1 || true
echo "$password" > "${PASS_DIR}/${username}"

# DB limite (upsert)
db_upsert_limit "$username" "$sshlimiter"

# recalcular expirados (Exp = numero)
recalc_expired_list

# =========================
# OVPN opcional
# =========================
if [[ -e /etc/openvpn/server.conf ]]; then
  echo -ne "\033[1;32mGerar Arquivo Ovpn \033[1;31m? \033[1;33m[s/n]:\033[1;37m "
  read -r resp

  if [[ "$resp" = @(s|S) ]]; then
    rm -f "/root/${username}.zip" "/root/${username}.ovpn" >/dev/null 2>&1 || true

    echo -ne "\033[1;32mGerar Com usuário e Senha \033[1;31m? \033[1;33m[s/n]:\033[1;37m "
    read -r respost

    echo -ne "\033[1;32mHost Atual\033[1;37m: \033[1;31m(\033[1;37m${Host:-Customizado}\033[1;31m) \033[1;37m- \033[1;32mAlterar \033[1;31m? \033[1;33m[s/n]:\033[1;37m "
    read -r oprc

    if [[ "$oprc" = @(s|S) ]]; then
      fun_edithost
    else
      fun_geraovpn
    fi

    if [[ -e "/root/${username}.ovpn" && ! -e "/root/${username}.zip" ]]; then
      zip -q "/root/${username}.zip" "/root/${username}.ovpn" >/dev/null 2>&1 || true
    fi

    clear
    echo -e "\033[0;34m╭━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╮\033[0m"
    echo -e "\033[0;34m┃\E[44;1;37m            CONTA SSH CRIADA             \E[0m\033[0;34m┃"
    echo -e "\033[0;34m╰━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╯\033[0m"
    echo -e "\033[1;32m 🗣️ USUARIO: \033[1;37m$username"
    echo -e "\033[1;32m 🔑 SENHA: \033[1;37m$password"
    echo -e "\033[1;32m ⌛ EXPIRA EM: \033[1;37m$gui"
    echo -e "\033[1;32m 📲 LIMITE: \033[1;37m$sshlimiter"
    echo ""

    if [[ -d /var/www/html/openvpn && -e "/root/${username}.zip" ]]; then
      mv "/root/${username}.zip" "/var/www/html/openvpn/${username}.zip" >/dev/null 2>&1 || true
      echo -e "\033[1;32mLINK\033[1;37m: \033[1;36mhttp://$IP:81/openvpn/${username}.zip"
    else
      echo -e "\033[1;32mDisponível em:\033[1;31m /root/${username}.zip\033[0m"
    fi

    echo -ne "\n\033[1;33mENTER \033[1;33mPARA VOLTAR AO \033[1;33mMENU!\033[0m"; read -r
    exit 0
  fi
fi

# =========================
# final (sem ovpn)
# =========================
clear
echo -e "\E[44;1;37m======🦸 DADOS DE ACESSO 🦸‍♀️======\E[0m"
echo -e "\033[1;32m 🗣️ USUARIO: \033[1;37m$username"
echo -e "\033[1;32m 🔑 SENHA: \033[1;37m$password"
echo -e "\033[1;32m ⌛ EXPIRA EM: \033[1;37m$gui"
echo -e "\033[1;32m 📲 LIMITE: \033[1;37m$sshlimiter"
echo -ne "\n\033[1;33mENTER \033[1;33mPARA VOLTAR AO \033[1;33mMENU!\033[0m"; read -r
