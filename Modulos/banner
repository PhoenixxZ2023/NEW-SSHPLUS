#!/bin/bash
clear

BANNER_FILE="/etc/bannerssh"
SSHD_CFG="/etc/ssh/sshd_config"
DROP_CFG="/etc/default/dropbear"

restart_svc() {
  local svc="$1"
  if command -v systemctl >/dev/null 2>&1; then
    systemctl restart "$svc" >/dev/null 2>&1 || service "$svc" restart >/dev/null 2>&1
  else
    service "$svc" restart >/dev/null 2>&1 || /etc/init.d/"$svc" restart >/dev/null 2>&1
  fi
}

has_dropbear() {
  pgrep -x dropbear >/dev/null 2>&1 && return 0
  command -v ss >/dev/null 2>&1 && ss -lntp 2>/dev/null | grep -q dropbear && return 0
  command -v netstat >/dev/null 2>&1 && netstat -nltp 2>/dev/null | grep -q dropbear && return 0
  return 1
}

ensure_banner_directive() {
  touch "$BANNER_FILE" >/dev/null 2>&1
  chmod 644 "$BANNER_FILE" >/dev/null 2>&1

  if grep -qE '^\s*Banner\s+' "$SSHD_CFG"; then
    # substitui qualquer Banner ativo
    sed -i -E "s|^\s*Banner\s+.*|Banner $BANNER_FILE|g" "$SSHD_CFG"
  else
    echo "Banner $BANNER_FILE" >> "$SSHD_CFG"
  fi
}

set_dropbear_banner() {
  # só se arquivo existir (padrão Debian/Ubuntu)
  [[ -f "$DROP_CFG" ]] || return 0

  if grep -qE '^\s*DROPBEAR_BANNER=' "$DROP_CFG"; then
    sed -i -E "s|^\s*DROPBEAR_BANNER=.*|DROPBEAR_BANNER=\"$BANNER_FILE\"|g" "$DROP_CFG"
  else
    echo "DROPBEAR_BANNER=\"$BANNER_FILE\"" >> "$DROP_CFG"
  fi
}

disable_banner_directive() {
  # forma mais limpa: Banner none
  if grep -qE '^\s*Banner\s+' "$SSHD_CFG"; then
    sed -i -E "s|^\s*Banner\s+.*|Banner none|g" "$SSHD_CFG"
  else
    echo "Banner none" >> "$SSHD_CFG"
  fi
}

# prepara diretivas
ensure_banner_directive
has_dropbear && set_dropbear_banner

echo -e "\E[44;1;37m             BANNER             \E[0m"
echo ""
echo -e "\033[1;31m[\033[1;36m1\033[1;31m]\033[1;37m • \033[1;33mADICIONAR BANNER"
echo -e "\033[1;31m[\033[1;36m2\033[1;31m]\033[1;37m • \033[1;33mREMOVER BANNER"
echo -e "\033[1;31m[\033[1;36m3\033[1;31m]\033[1;37m • \033[1;33mVOLTAR"
echo ""
echo -ne "\033[1;32mOQUE DESEJA FAZER\033[1;31m ?\033[1;37m : "
read -r resp

if [[ "$resp" = "1" ]]; then
  echo ""
  echo -ne "\033[1;32mQUAL MENSAGEM DESEJA EXIBIR\033[1;31m ?\033[1;37m : "
  read -r msg1

  if [[ -z "${msg1// }" ]]; then
    echo -e "\n\033[1;31mCampo vazio ou invalido !\033[0m"
    sleep 2
    banner
  fi

  echo -e "\n\033[1;31m[\033[1;36m01\033[1;31m]\033[1;33m FONTE PEQUENA"
  echo -e "\033[1;31m[\033[1;36m02\033[1;31m]\033[1;33m FONTE MEDIA"
  echo -e "\033[1;31m[\033[1;36m03\033[1;31m]\033[1;33m FONTE GRANDE"
  echo -e "\033[1;31m[\033[1;36m04\033[1;31m]\033[1;33m FONTE GIGANTE"
  echo ""
  echo -ne "\033[1;32mQUAL O TAMANHO DA FONTE\033[1;31m ?\033[1;37m : "
  read -r opc

  # “fonte” real não existe no SSH banner; vamos só decorar
  case "$opc" in
    1|01) deco="== " ;;
    2|02) deco="==== " ;;
    3|03) deco="====== " ;;
    4|04) deco="======== " ;;
    *) deco="== " ;;
  esac

  echo -e "\n\033[1;31m[\033[1;36m01\033[1;31m]\033[1;33m AZUL"
  echo -e "\033[1;31m[\033[1;36m02\033[1;31m]\033[1;33m VERDE"
  echo -e "\033[1;31m[\033[1;36m03\033[1;31m]\033[1;33m VERMELHO"
  echo -e "\033[1;31m[\033[1;36m04\033[1;31m]\033[1;33m AMARELO"
  echo -e "\033[1;31m[\033[1;36m05\033[1;31m]\033[1;33m ROSA"
  echo -e "\033[1;31m[\033[1;36m06\033[1;31m]\033[1;33m CYANO"
  echo -e "\033[1;31m[\033[1;36m07\033[1;31m]\033[1;33m LARANJA"
  echo -e "\033[1;31m[\033[1;36m08\033[1;31m]\033[1;33m ROXO"
  echo -e "\033[1;31m[\033[1;36m09\033[1;31m]\033[1;33m PRETO"
  echo -e "\033[1;31m[\033[1;36m10\033[1;31m]\033[1;33m SEM COR"
  echo ""
  echo -ne "\033[1;32mQUAL A COR\033[1;31m ?\033[1;37m : "
  read -r ban_cor

  # ANSI cores (podem não aparecer em alguns clientes; mas é o melhor que dá)
  case "$ban_cor" in
    1|01) color="\e[34;1m" ;; # azul
    2|02) color="\e[32;1m" ;; # verde
    3|03) color="\e[31;1m" ;; # vermelho
    4|04) color="\e[33;1m" ;; # amarelo
    5|05) color="\e[35;1m" ;; # rosa/magenta
    6|06) color="\e[36;1m" ;; # ciano
    7|07) color="\e[33;1m" ;; # laranja ~ amarelo forte
    8|08) color="\e[35;1m" ;; # roxo ~ magenta
    9|09) color="\e[30;1m" ;; # preto (quase invisível)
    10)   color="" ;;
    *) echo -e "\n\033[1;31mOpcao invalida !\033[0m"; sleep 2; banner ;;
  esac

  # escreve banner (substitui o conteúdo)
  {
    echo -e "${color}${deco}${msg1}\e[0m"
  } > "$BANNER_FILE"

  restart_svc ssh
  has_dropbear && restart_svc dropbear

  echo -e "\n\033[1;32mBANNER DEFINIDO !\033[0m"
  sleep 2
  menu

elif [[ "$resp" = "2" ]]; then
  # remove conteúdo e desativa Banner no sshd
  : > "$BANNER_FILE"
  disable_banner_directive

  restart_svc ssh
  has_dropbear && restart_svc dropbear

  echo -e "\n\033[1;32mBANNER EXCLUIDO !\033[0m"
  sleep 2
  menu

elif [[ "$resp" = "3" ]]; then
  menu
else
  echo -e "\n\033[1;31mOpcao invalida !\033[0m"
  sleep 2
  banner
fi
