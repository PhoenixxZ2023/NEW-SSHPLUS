#!/bin/bash
# expcleaner - remove usuários expirados (SSHPlus) | /etc/SSHPlus/Exp = contador (zera no final)

set -u
shopt -s extglob

DB="/root/usuarios.db"
PASS_DIR="/etc/SSHPlus/senha"
EXP_FILE="/etc/SSHPlus/Exp"

datenow="$(date +%s)"

# Detecta group para chown do crl.pem (Debian costuma usar nogroup)
GROUPNAME="nobody"
if [[ -e /etc/debian_version ]]; then
  GROUPNAME="nogroup"
fi

safe_return_menu() {
  if declare -F menu >/dev/null 2>&1; then
    menu
  elif command -v menu >/dev/null 2>&1; then
    menu
  else
    exit 0
  fi
}

remove_ovp() {
  local user="$1"

  [[ -d /etc/openvpn/easy-rsa ]] || return 0
  [[ -x /etc/openvpn/easy-rsa/easyrsa ]] || return 0

  (
    cd /etc/openvpn/easy-rsa/ || exit 0
    ./easyrsa --batch revoke "$user" >/dev/null 2>&1 || true
    ./easyrsa gen-crl >/dev/null 2>&1 || true

    rm -f "pki/reqs/${user}.req" \
          "pki/private/${user}.key" \
          "pki/issued/${user}.crt" >/dev/null 2>&1 || true

    rm -f /etc/openvpn/crl.pem >/dev/null 2>&1 || true
    if [[ -f /etc/openvpn/easy-rsa/pki/crl.pem ]]; then
      cp /etc/openvpn/easy-rsa/pki/crl.pem /etc/openvpn/crl.pem >/dev/null 2>&1 || true
      chown nobody:"$GROUPNAME" /etc/openvpn/crl.pem >/dev/null 2>&1 || true
    fi
  ) >/dev/null 2>&1

  rm -f "$HOME/${user}.ovpn" >/dev/null 2>&1 || true
  rm -f "/var/www/html/openvpn/${user}.zip" >/dev/null 2>&1 || true
}

# Garantias de arquivos/pastas
mkdir -p "$(dirname "$DB")" "$(dirname "$EXP_FILE")" "$PASS_DIR" >/dev/null 2>&1 || true
touch "$DB" "$EXP_FILE" >/dev/null 2>&1 || true

clear
echo -e "\E[44;1;37m Usuario          Data         Estado         Ação   \E[0m"
echo ""

removed=0

# varre usuários "reais" (uid>=1000), ignora comuns
while IFS=: read -r user _ uid _ _ _ _; do
  [[ "$uid" -ge 1000 ]] || continue
  [[ "$user" =~ ^(nobody|ubuntu|lxd)$ ]] && continue

  expdate="$(chage -l "$user" 2>/dev/null | awk -F': ' '/^Account expires/ {print $2; exit}')"
  [[ -z "${expdate:-}" ]] && continue
  [[ "$expdate" == "never" ]] && continue

  expsec="$(date -d "$expdate" +%s 2>/dev/null || echo "")"
  [[ -z "${expsec:-}" ]] && continue

  datanormal="$(date -d "$expdate" '+%d/%m/%Y' 2>/dev/null || echo "$expdate")"

  tput setaf 3; tput bold
  printf '%-15s%-13s' "$user" "$datanormal"
  tput sgr0
  printf '%-13s' " "

  if (( expsec > datenow )); then
    tput setaf 2; tput bold
    echo "VALIDO         NAO REMOVIDO"
    tput sgr0
    continue
  fi

  removed=$((removed + 1))
  tput setaf 1; tput bold
  echo "VENCEU         FOI REMOVIDO"
  tput sgr0

  # mata sessões
  pkill -u "$user" >/dev/null 2>&1 || true
  pkill -f "$user" >/dev/null 2>&1 || true

  # remove usuário
  if command -v userdel >/dev/null 2>&1; then
    userdel --force "$user" >/dev/null 2>&1 || true
  fi
  if command -v deluser >/dev/null 2>&1; then
    deluser --force "$user" >/dev/null 2>&1 || true
  fi

  # limpa do DB
  if [[ -f "$DB" ]]; then
    grep -v -E "^${user}[[:space:]]+" "$DB" > /tmp/usuarios.db.$$ 2>/dev/null || true
    cat /tmp/usuarios.db.$$ > "$DB" 2>/dev/null || true
    rm -f /tmp/usuarios.db.$$ >/dev/null 2>&1 || true
  fi

  # remove senha salva
  rm -f "${PASS_DIR}/${user}" >/dev/null 2>&1 || true

  # revoga OVPN se existir
  if [[ -e /etc/openvpn/server.conf ]]; then
    remove_ovp "$user"
  fi

done < /etc/passwd

# contador (zera)
echo "0" > "$EXP_FILE" 2>/dev/null || true

echo ""
tput setaf 7; tput setab 4; tput bold
echo "  EXP CLEANER FINALIZADO | REMOVIDOS: $removed  "
tput sgr0
echo ""

sleep 2
safe_return_menu
