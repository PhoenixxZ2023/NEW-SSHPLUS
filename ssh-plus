#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

#--------------------------
# SCRIPT NEW-SSHPLUS
# TELEGRAM: @TURBONET2023
#--------------------------

RED='\033[1;31m'
YELLOW='\033[1;33m'
SCOLOR='\033[0m'

die() { echo -e "${RED}[x] ${1}${SCOLOR}"; exit 1; }

# Root
[[ "${EUID}" -eq 0 ]] || die "VC PRECISA EXECULTAR COMO USUARIO ROOT !"

# Arch
case "$(uname -m)" in
  x86_64|amd64)  arch_dir="64" ;;
  aarch64|arm64|armv8*) arch_dir="arm64" ;;
  *) die "ARQUITETURA INCOMPATIVEL: $(uname -m)" ;;
esac

# OS (Debian/Ubuntu)
if [[ -r /etc/os-release ]]; then
  . /etc/os-release
else
  die "NAO FOI POSSIVEL LER /etc/os-release"
fi

case "${ID:-}" in
  ubuntu)
    # 22.04 => 22, 24.04 => 24
    major="${VERSION_ID%%.*}"
    [[ "${major}" -ge 18 ]] || die "UBUNTU INCOMPATIVEL! REQUER 18.04+"
    ;;
  debian)
    major="${VERSION_ID%%.*}"
    [[ "${major}" -ge 9 ]] || die "DEBIAN INCOMPATIVEL! REQUER 9+"
    ;;
  *)
    die "OS INCOMPATIVEL! REQUER DEBIAN/UBUNTU (detectado: ${ID:-desconhecido})"
    ;;
esac

export DEBIAN_FRONTEND=noninteractive

# deps mínimas (sem upgrade geral)
apt-get update -y
apt-get install -y --no-install-recommends ca-certificates curl unzip python3

# IPv6 (DEIXE OPCIONAL - comente se não quiser)
echo 'net.ipv6.conf.all.disable_ipv6 = 1' > /etc/sysctl.d/70-disable-ipv6.conf
sysctl -p -f /etc/sysctl.d/70-disable-ipv6.conf

# Download + Exec
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

PLUS_URL="https://raw.githubusercontent.com/PhoenixxZ2023/NEW-SSHPLUS/main/script/${arch_dir}/Plus"
PLUS_BIN="${tmp}/Plus"

curl -fsSL "$PLUS_URL" -o "$PLUS_BIN" || die "FALHA AO BAIXAR: $PLUS_URL"
chmod 777 "$PLUS_BIN"
"$PLUS_BIN"
