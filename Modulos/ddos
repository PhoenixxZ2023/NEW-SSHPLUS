#!/bin/bash

# =========================
# PORTAS PADRÃO SSHPLUS
# =========================
SSHPLUS_PORTS="22,443,80,8080,3128,8443,1080"

# =========================
# FUN_BAR (corrigido)
# =========================
fun_bar() {
  local cmd1="${1:-}"
  local cmd2="${2:-}"

  (
    [[ -e "$HOME/fim" ]] && rm -f "$HOME/fim"
    [[ -n "$cmd1" ]] && bash -c "$cmd1" >/dev/null 2>&1
    [[ -n "$cmd2" ]] && bash -c "$cmd2" >/dev/null 2>&1
    touch "$HOME/fim"
  ) >/dev/null 2>&1 &

  tput civis
  echo -ne "\033[1;33m["
  while true; do
    for ((i=0; i<18; i++)); do
      echo -ne "\033[1;31m#"
      sleep 0.1s
    done
    [[ -e "$HOME/fim" ]] && rm -f "$HOME/fim" && break
    echo -e "\033[1;33m]"
    sleep 1s
    tput cuu1
    tput dl1
    echo -ne "\033[1;33m["
  done
  echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
  tput cnorm
}

# =========================
# DETECÇÃO DE PACOTES
# =========================
has_pkg() { dpkg -s "$1" >/dev/null 2>&1; }

HAS_FAIL2BAN=0; has_pkg fail2ban && HAS_FAIL2BAN=1
HAS_SSH=0;      has_pkg openssh-server && HAS_SSH=1
HAS_DROPBEAR=0; has_pkg dropbear && HAS_DROPBEAR=1
HAS_APACHE=0;   has_pkg apache2 && HAS_APACHE=1
HAS_SQUID=0;    has_pkg squid && HAS_SQUID=1
HAS_STUNNEL=0;  has_pkg stunnel4 && HAS_STUNNEL=1

use_systemd_backend() {
  command -v systemctl >/dev/null 2>&1 && echo "systemd" || echo "auto"
}

write_jail_local() {
  local backend
  backend="$(use_systemd_backend)"

  mkdir -p /etc/fail2ban

  cat > /etc/fail2ban/jail.local <<EOF
[DEFAULT]
ignoreip = 127.0.0.1/8
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = ${backend}
banaction = iptables-multiport

# Portas padrão do SSHPlus
# (usado nas ações de bloqueio)
EOF

  # =====================
  # SSHD
  # =====================
  if [[ "$HAS_SSH" -eq 1 ]]; then
    cat >> /etc/fail2ban/jail.local <<EOF

[sshd]
enabled = true
port    = ${SSHPLUS_PORTS}
EOF
  else
    cat >> /etc/fail2ban/jail.local <<'EOF'

[sshd]
enabled = false
EOF
  fi

  # =====================
  # DROPBEAR (somente se existir filtro)
  # =====================
  if [[ "$HAS_DROPBEAR" -eq 1 && -f /etc/fail2ban/filter.d/dropbear.conf ]]; then
    cat >> /etc/fail2ban/jail.local <<EOF

[dropbear]
enabled = true
port    = ${SSHPLUS_PORTS}
EOF
  else
    cat >> /etc/fail2ban/jail.local <<'EOF'

[dropbear]
enabled = false
EOF
  fi

  # =====================
  # APACHE-AUTH
  # =====================
  if [[ "$HAS_APACHE" -eq 1 ]]; then
    cat >> /etc/fail2ban/jail.local <<EOF

[apache-auth]
enabled = true
port    = 80,443,8080,8443
EOF
  else
    cat >> /etc/fail2ban/jail.local <<'EOF'

[apache-auth]
enabled = false
EOF
  fi

  # =====================
  # SQUID (somente se squid instalado)
  # =====================
  if [[ "$HAS_SQUID" -eq 1 ]]; then
    cat >> /etc/fail2ban/jail.local <<'EOF'

[squid]
enabled = true
port    = 80,8080,3128
logpath = /var/log/squid/access.log
EOF
  else
    cat >> /etc/fail2ban/jail.local <<'EOF'

[squid]
enabled = false
EOF
  fi

  # =====================
  # STUNNEL (opcional)
  # =====================
  # Obs: nem todo pacote traz filtro/jail pronto. Então fica desabilitado por padrão.
  if [[ "$HAS_STUNNEL" -eq 1 && -f /etc/fail2ban/filter.d/stunnel.conf ]]; then
    cat >> /etc/fail2ban/jail.local <<EOF

[stunnel]
enabled = true
port    = 443,8443
logpath = /var/log/stunnel4/stunnel.log
EOF
  else
    cat >> /etc/fail2ban/jail.local <<'EOF'

[stunnel]
enabled = false
EOF
  fi

  # =====================
  # RECIDIVE (opcional, forte)
  # =====================
  cat >> /etc/fail2ban/jail.local <<'EOF'

[recidive]
enabled  = true
logpath  = /var/log/fail2ban.log
bantime  = 1w
findtime = 1d
maxretry = 5
EOF
}

start_fail2ban() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now fail2ban >/dev/null 2>&1
    systemctl restart fail2ban >/dev/null 2>&1
  else
    service fail2ban restart >/dev/null 2>&1
  fi
}

stop_fail2ban() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl stop --now fail2ban >/dev/null 2>&1
  else
    service fail2ban stop >/dev/null 2>&1
  fi
}

show_log() {
  clear
  echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
  echo -e "\E[41;1;37m               FAIL2BAN LOG                         \E[0m"
  echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
  if [[ -f /var/log/fail2ban.log ]]; then
    tail -n 200 /var/log/fail2ban.log
  else
    echo -e "\033[1;33mLog /var/log/fail2ban.log não encontrado.\033[0m"
    echo -e "\033[1;36mDica: journalctl -u fail2ban --no-pager | tail -n 200\033[0m"
  fi
  echo ""
  echo -ne "\n\033[1;31mENTER \033[1;33mpara retornar ao \033[1;32mMENU!\033[0m"; read
}

fail2ban_function() {
  if [[ "$HAS_FAIL2BAN" -eq 1 ]]; then
    clear
    tput setaf 7 ; tput setab 4 ; tput bold ; printf '%32s%s%-13s\n' "PROTEÇÃO ATIVADA! O QUE DESEJA FAZER?" ; tput sgr0
    echo ""
    echo -e "\033[1;31m[\033[1;36m1\033[1;31m]\033[1;33m DESINSTALAR"
    echo -e "\033[1;31m[\033[1;36m2\033[1;31m]\033[1;33m VER LOG"
    echo -e "\033[1;31m[\033[1;36m3\033[1;31m]\033[1;33m STATUS"
    echo ""
    read -p "$(echo -e "\033[1;32mOPÇÃO\033[1;31m ?\033[1;37m : ")" lo_og

    case "$lo_og" in
      2) show_log; return ;;
      3)
        clear
        if command -v fail2ban-client >/dev/null 2>&1; then
          fail2ban-client status 2>/dev/null
          echo ""
          fail2ban-client status sshd 2>/dev/null || true
        else
          echo "fail2ban-client não encontrado."
        fi
        echo -ne "\n\033[1;31mENTER \033[1;33mpara retornar ao \033[1;32mMENU!\033[0m"; read
        return
        ;;
      1)
        echo ""
        echo -e "\033[1;32mREMOVENDO FAIL2BAN...\033[0m"
        echo ""
        fun_bar "stop_fail2ban" "apt-get purge -y fail2ban"
        rm -f /etc/fail2ban/jail.local >/dev/null 2>&1
        echo -e "\n\033[1;32mREMOVIDO COM SUCESSO!\033[0m"
        sleep 1.5
        return
        ;;
      *) return ;;
    esac
  fi

  clear
  echo -e "\033[1;32mINICIANDO A PROTEÇÃO (FAIL2BAN)...\033[0m\n"
  echo -e "\033[1;33mVai proteger as portas do SSHPlus: ${SSHPLUS_PORTS}\033[0m"
  echo ""
  read -p "$(echo -e "\033[1;32mDESEJA INSTALAR \033[1;31m? \033[1;33m[s/n]:\033[1;37m ")" resp

  if [[ "$resp" =~ ^[sS]$ ]]; then
    echo ""
    echo -e "\033[1;32mINSTALANDO FAIL2BAN...\033[0m"
    echo ""
    fun_bar "apt-get update -y" "apt-get install -y fail2ban"

    write_jail_local
    start_fail2ban

    echo ""
    echo -e "\033[1;32mINSTALAÇÃO CONCLUÍDA!\033[0m"
    echo -e "\033[1;33mProtegendo: ${SSHPLUS_PORTS}\033[0m"
    sleep 1.5
  fi
}

fail2ban_function
