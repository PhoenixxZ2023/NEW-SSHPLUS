#!/bin/bash
datenow=$(date +%s)

remove_ovp () {
  if [[ -e /etc/debian_version ]]; then
    GROUPNAME=nogroup
  else
    GROUPNAME=nobody
  fi

  user="$1"
  cd /etc/openvpn/easy-rsa/ || return 0

  ./easyrsa --batch revoke "$user"
  ./easyrsa gen-crl

  rm -rf "pki/reqs/$user.req"
  rm -rf "pki/private/$user.key"
  rm -rf "pki/issued/$user.crt"

  rm -f /etc/openvpn/crl.pem
  cp /etc/openvpn/easy-rsa/pki/crl.pem /etc/openvpn/crl.pem
  chown nobody:"$GROUPNAME" /etc/openvpn/crl.pem

  [[ -e "$HOME/$user.ovpn" ]] && rm -f "$HOME/$user.ovpn" >/dev/null 2>&1
  [[ -e "/var/www/html/openvpn/$user.zip" ]] && rm -f "/var/www/html/openvpn/$user.zip" >/dev/null 2>&1
} >/dev/null 2>&1

recalc_exp_count() {
  local datenow expdate expsec count=0 user
  datenow="$(date +%s)"

  for user in $(awk -F: '{print $1}' /etc/passwd); do
    expdate="$(chage -l "$user" 2>/dev/null | awk -F: '/Account expires/ {gsub(/^ /,"",$2); print $2; exit}')"
    [[ -z "$expdate" ]] && continue
    echo "$expdate" | grep -qi never && continue

    expsec="$(date +%s --date="$expdate" 2>/dev/null)" || continue
    if (( datenow >= expsec )); then
      ((count++))
    fi
  done

  echo "$count" > /etc/SSHPlus/Exp
}

echo -e "\E[44;1;37m Usuario          Data         Estado         Ação   \E[0m"
echo ""

for user in $(awk -F: '{print $1}' /etc/passwd); do
  expdate=$(chage -l "$user" | awk -F: '/Account expires/{print $2}')
  echo "$expdate" | grep -q never && continue

  datanormal=$(date -d"$expdate" '+%d/%m/%Y' 2>/dev/null)
  tput setaf 3; tput bold
  printf '%-15s%-17s%s' "$user" "$datanormal"
  tput sgr0

  expsec=$(date +%s --date="$expdate" 2>/dev/null)
  [[ -z "$expsec" ]] && { echo "ERRO    NAO REMOVIDO"; continue; }

  if (( datenow < expsec )); then
    tput setaf 2; tput bold
    echo "VALIDO   NAO REMOVIDO"
    continue
  fi

  tput setaf 1; tput bold
  echo "VENCEU   FOI REMOVIDO"

  pkill -f "$user" >/dev/null 2>&1
  userdel --force "$user" >/dev/null 2>&1

  grep -v "^$user[[:space:]]" /root/usuarios.db > /tmp/ph && cat /tmp/ph > /root/usuarios.db
  rm -f /tmp/ph >/dev/null 2>&1

  if [[ -e /etc/openvpn/server.conf ]]; then
    remove_ovp "$user"
  fi
done

# ao invés de "echo 0", recalcula corretamente
recalc_exp_count

tput sgr0
echo ""
