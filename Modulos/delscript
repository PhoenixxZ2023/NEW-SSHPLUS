#!/bin/bash

echo -e "\033[0;34m┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\033[0m"
echo -e "\033[0;34m┃\E[44;1;37m          DESINSTALAR O SCRIPT           \E[0m\033[0;34m┃"
echo -e "\033[0;34m┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\033[0m\n"

read -p "DESEJA REMOVER? [s/n] " resp

if [[ "$resp" =~ ^[sS]$ ]]; then

  # --- Funções ---
  stop_service_any() {
    local svc="$1"
    if command -v systemctl >/dev/null 2>&1; then
      systemctl stop "$svc" >/dev/null 2>&1
      systemctl disable "$svc" >/dev/null 2>&1
    fi
    service "$svc" stop >/dev/null 2>&1
    /etc/init.d/"$svc" stop >/dev/null 2>&1
  }

  purge_pkg_if_installed() {
    local pkg="$1"
    dpkg -l 2>/dev/null | awk '{print $2,$1}' | grep -qw "^${pkg} ii" && {
      apt-get purge -y "$pkg" >/dev/null 2>&1
      apt-get autoremove -y >/dev/null 2>&1
    }
  }

  echo -e "\n\033[1;33mREMOVENDO SERVIÇOS...\033[0m"

  # Para serviços comuns do SSHPlus (sem quebrar o SSH do sistema)
  stop_service_any dropbear
  stop_service_any squid
  stop_service_any squid3
  stop_service_any openvpn
  stop_service_any fail2ban
  stop_service_any sslh
  stop_service_any stunnel4
  stop_service_any stunnel5

  # Mata processos típicos do “proxy”/python/ws/security se existirem
  pkill -f "WebSocket" >/dev/null 2>&1
  pkill -f "security" >/dev/null 2>&1
  pkill -f "proxydt" >/dev/null 2>&1
  pkill -f "/proxy"  >/dev/null 2>&1
  pkill -f "dragonx" >/dev/null 2>&1
  pkill -f "slowdns" >/dev/null 2>&1
  pkill -f "badvpn-udpgw" >/dev/null 2>&1

  # --- Pacotes (remove só se estiverem instalados) ---
  echo -e "\033[1;33mREMOVENDO PACOTES...\033[0m"
  purge_pkg_if_installed screen
  purge_pkg_if_installed nmap
  purge_pkg_if_installed figlet
  purge_pkg_if_installed squid
  purge_pkg_if_installed squid3
  purge_pkg_if_installed dropbear
  purge_pkg_if_installed apache2
  purge_pkg_if_installed zip
  purge_pkg_if_installed fail2ban
  purge_pkg_if_installed sslh
  purge_pkg_if_installed stunnel4

  # OBS: stunnel5 geralmente não é pacote padrão (muita gente compila /usr/local).
  # então vamos remover diretórios/arquivos conhecidos abaixo.

  # --- Remoção de binários/atalhos do script ---
  echo -e "\033[1;33mREMOVENDO ARQUIVOS DO SSHPLUS...\033[0m"

  # lista original + alguns extras comuns
  bins=(
    criarusuario expcleaner sshlimiter addhost listar sshmonitor ajuda menu OpenVPN
    userbackup tcpspeed badvpn otimizar speedtest trafego banner limit limite senharoot
    reiniciarservicos reiniciarsistema attscript criarteste socks DropBear alterarlimite
    alterarsenha remover detalhes mudardata botssh infousers droplimiter conexao onlineapp
    botteste trojan-go v2raymanager versao Plus proxy proxydt security slowdns sslh
  )

  for b in "${bins[@]}"; do
    rm -f "/bin/$b" "/usr/local/bin/$b" "/usr/bin/$b" >/dev/null 2>&1
  done

  # remove badvpn se você baixa em /bin
  rm -f /bin/badvpn-udpgw >/dev/null 2>&1

  # --- Remove diretórios e resíduos do SSHPlus ---
  rm -rf /etc/SSHPlus >/dev/null 2>&1
  rm -rf /etc/Plus-torrent >/dev/null 2>&1
  rm -rf /etc/bannerssh >/dev/null 2>&1

  # stunnel5 (quando instalado em /usr/local)
  rm -rf /usr/local/etc/stunnel >/dev/null 2>&1
  rm -f /usr/local/bin/stunnel5 /usr/local/sbin/stunnel5 >/dev/null 2>&1

  # limpa autostart se existir e remover linhas conhecidas
  if [[ -f /etc/autostart ]]; then
    sed -i '/udpvpn/d;/badvpn-udpgw/d;/slowdns/d;/proxydt/d;/security/d;/WebSocket/d;/sslh/d;/dragonx/d;/\/proxy/d' /etc/autostart >/dev/null 2>&1
  fi

  # backups (opcional) - você pode comentar se quiser manter
  rm -rf /etc/SSHPlus/backups >/dev/null 2>&1

  # --- Final ---
  clear
  echo -e "\n\033[1;36mOBRIGADO POR UTILIZAR O SCRIPT SSH-PLUS\033[0m"
  echo -e "\033[1;33mSSHPLUS REMOVIDO.\033[0m\n"
  sleep 1
  exit 0

else
  echo -e "\n\033[1;32mOK RETORNANDO...\033[0m"
  sleep 1
  menu
fi
