#!/bin/bash
set -euo pipefail

DB="/root/usuarios.db"

# ===== CORES / ESTILO =====
BOLD="\033[1m"
RESET="\033[0m"
BLUE="\033[1;34m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
CYAN="\033[1;36m"
WHITE="\033[1;37m"

titulo() { echo -e "${BLUE}${BOLD}${*^^}${RESET}"; }
ok()     { echo -e "${GREEN}${BOLD}${*^^}${RESET}"; }
warn()   { echo -e "${YELLOW}${BOLD}${*^^}${RESET}"; }
err()    { echo -e "${RED}${BOLD}${*^^}${RESET}"; }

# ===== VALIDACOES =====
if [[ ! -f "$DB" ]]; then
  err "ARQUIVO $DB NAO ENCONTRADO"
  exit 1
fi

# ===== LISTA DE USUARIOS =====
# uid>=1000 e ignora contas comuns
mapfile -t USERS < <(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -Ev '^(nobody|ubuntu|lxd)$')

if [[ "${#USERS[@]}" -eq 0 ]]; then
  warn "NAO HA USUARIOS PARA EXIBIR"
  exit 0
fi

clear
titulo "ALTERAR LIMITE DE CONEXOES SIMULTANEAS"
echo

warn "LISTA DE USUARIOS E SEUS LIMITES:"
echo

# Mostra lista numerada com limite atual (se não existir no DB, assume 1)
for i in "${!USERS[@]}"; do
  n=$((i+1))
  u="${USERS[$i]}"

  if grep -qE "^${u}[[:space:]]+" "$DB"; then
    lim="$(awk -v user="$u" '$1==user{print $2; exit}' "$DB")"
    [[ -z "${lim:-}" ]] && lim="1"
  else
    lim="1"
  fi

  printf "${RED}[${CYAN}%02d${RED}] ${WHITE}- ${GREEN}%s${RESET}    ${YELLOW}LIMITE${WHITE}: %s${RESET}\n" "$n" "$u" "$lim"
done

echo
echo -ne "${GREEN}${BOLD}DIGITE OU SELECIONE UM USUARIO${RESET} ${YELLOW}[1-${#USERS[@]}]${RESET}${WHITE}: ${RESET}"
read -r opt

if [[ -z "${opt:-}" || ! "$opt" =~ ^[0-9]+$ ]]; then
  err "OPCAO INVALIDA"
  exit 1
fi

if (( opt < 1 || opt > ${#USERS[@]} )); then
  err "OPCAO FORA DO INTERVALO"
  exit 1
fi

usuario="${USERS[$((opt-1))]}"

echo
echo -ne "${GREEN}${BOLD}NOVO LIMITE PARA O USUARIO${RESET} ${YELLOW}${usuario}${RESET}${WHITE}: ${RESET}"
read -r sshnum

if [[ -z "${sshnum:-}" || ! "$sshnum" =~ ^[0-9]+$ ]]; then
  err "NUMERO INVALIDO"
  exit 1
fi

if (( sshnum < 1 )); then
  err "O LIMITE DEVE SER MAIOR QUE ZERO"
  exit 1
fi

# ===== UPSERT ATOMICO NO DB =====
tmp="$(mktemp)"
# Remove linha antiga do usuário (match exato no 1º campo) e grava no tmp
awk -v user="$usuario" '$1!=user {print $0}' "$DB" > "$tmp"
# Adiciona a linha nova
echo "$usuario $sshnum" >> "$tmp"
# Substitui o DB de forma atômica
cat "$tmp" > "$DB"
rm -f "$tmp"

echo
ok "LIMITE APLICADO PARA O USUARIO $usuario FOI $sshnum"
sleep 2
exit 0
