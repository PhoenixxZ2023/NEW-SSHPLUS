set -u
shopt -s extglob

database="/root/usuarios.db"
[[ -f /usr/lib/licence ]] || exit 0
[[ -f "$database" ]] || exit 0

# ---------- UI ----------
clear
echo -e "\033[0;34m╭━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╮\033[0m"
echo -e "\033[0;34m┃\E[44;1;37m USUARIO         STATUS       CONEXAO     TEMPO   \E[0m\033[0;34m┃"
echo -e "\033[0;34m╰━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╯\033[0m\n"

# ---------- Helpers ----------
# Pega limite do DB: "user limit"
get_limit() {
  local u="$1"
  awk -v U="$u" '$1==U{print $2; found=1; exit} END{if(!found) print "0"}' "$database"
}

# Conta SSH (sshd: user@...) mais confiável
count_ssh() {
  local u="$1"
  ps -eo args 2>/dev/null | grep -E "^sshd: ${u}@|^sshd: ${u} " | grep -v "priv" | wc -l
}

# Tempo SSH (pega o primeiro processo do usuário no sshd:)
ssh_time() {
  local u="$1" pid et
  pid="$(ps -eo pid,args 2>/dev/null | awk -v U="$u" '$0 ~ ("sshd: "U"@") {print $1; exit}')"
  if [[ -n "${pid:-}" ]]; then
    et="$(ps -o etime= -p "$pid" 2>/dev/null | xargs)"
    [[ -n "${et:-}" ]] && { 
      # normaliza pra HH:MM:SS (se vier MM:SS ou DD-HH:MM:SS)
      if [[ "$et" =~ ^[0-9]+-[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then
        # DD-HH:MM:SS -> HH:MM:SS (mantém como está, já é válido)
        echo "$et"
      elif [[ "$et" =~ ^[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then
        echo "$et"
      else
        echo "00:$et"
      fi
      return
    }
  fi
  echo "00:00:00"
}

# Dropbear: conta sessões via processos "dropbear -p ... -P ... -W ... user"
count_dropbear() {
  local u="$1"
  ps -eo args 2>/dev/null | grep -E "^dropbear" | grep -w "$u" | grep -v grep | wc -l
}

# OpenVPN status: tenta achar arquivo de status em locais comuns
find_ovpn_status() {
  local f
  for f in \
    /etc/openvpn/openvpn-status.log \
    /etc/openvpn/openvpn-status.txt \
    /var/log/openvpn/openvpn-status.log \
    /var/log/openvpn/status.log \
    /run/openvpn-server/status*.log \
    /run/openvpn/status*.log
  do
    ls $f >/dev/null 2>&1 && { ls $f 2>/dev/null | head -n1; return; }
  done
  return 1
}

# Conta OpenVPN (tenta CSV e formato comum)
count_ovpn() {
  local u="$1" st
  st="$(find_ovpn_status 2>/dev/null || true)"
  [[ -z "${st:-}" ]] && { echo 0; return; }

  # muitos status logs tem "CLIENT_LIST" ou linhas com user,
  # aqui fazemos um count robusto tentando padrões comuns
  grep -E "(${u})(,|[[:space:]])" "$st" 2>/dev/null | grep -vE "ROUTING|GLOBAL|HEADER" | wc -l
}

# OpenVPN tempo: difícil sem formato estável -> mantemos 00:00:00 (ou usa ssh_time se SSH>0)
# Se quiser, depois eu implemento parser do status baseado no formato do teu log real.

# ---------- Loop ----------
while IFS= read -r usline; do
  [[ -z "${usline:-}" ]] && continue

  user="$(echo "$usline" | awk '{print $1}')"
  s2ssh="$(echo "$usline" | awk '{print $2}')"

  [[ -z "${user:-}" ]] && continue
  [[ -z "${s2ssh:-}" ]] && s2ssh="0"

  # valida user simples pra evitar quebra
  [[ "$user" =~ ^[a-zA-Z0-9._-]+$ ]] || continue

  # conexões
  sqd="$(count_ssh "$user")"
  drop="$(count_dropbear "$user")"
  ovp="$(count_ovpn "$user")"

  cnx=$((sqd + drop))
  conex=$((cnx + ovp))

  # tempo: prioriza SSH, senão 00:00:00
  if (( cnx > 0 )); then
    timerr="$(ssh_time "$user")"
  else
    timerr="00:00:00"
  fi

  # status e print
  if (( conex == 0 )); then
    status="\033[1;31mOFFLINE\033[1;33m       "
  else
    status="\033[1;32mONLINE\033[1;33m        "
  fi

  echo -ne "\033[1;33m"
  printf '%-17s%-14b%-10s%s\n' " $user" "$status" "$conex/$s2ssh" "$timerr"

done < "$database"
