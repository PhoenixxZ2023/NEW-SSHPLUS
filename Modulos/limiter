#!/bin/bash
#====================================================
# SSH and OpenVPN Connection Limiter (revisado)
#====================================================

set -u

database="/root/usuarios.db"
logfile="/var/log/limiter.log"
ovpn_status="/etc/openvpn/openvpn-status.log"
ovpn_mgmt_host="127.0.0.1"
ovpn_mgmt_port="7505"
sleep_time="15"

# Garantias mínimas
[[ -f "$database" ]] || { echo "ERRO: database $database não existe"; exit 1; }
touch "$logfile" 2>/dev/null || { echo "ERRO: não consigo escrever em $logfile"; exit 1; }

have_cmd() { command -v "$1" >/dev/null 2>&1; }

mgmt_up() {
  if have_cmd ss; then
    ss -lnt 2>/dev/null | awk '{print $4}' | grep -q ":${ovpn_mgmt_port}$"
  else
    netstat -nlt 2>/dev/null | grep -q ":${ovpn_mgmt_port} "
  fi
}

mgmt_kill() {
  # usa nc se existir; senão tenta telnet
  local target="$1"
  if have_cmd nc; then
    { printf "kill %s\nquit\n" "$target"; } | nc -w 2 "$ovpn_mgmt_host" "$ovpn_mgmt_port" >/dev/null 2>&1
    return $?
  elif have_cmd telnet; then
    ( echo "kill $target"; echo "quit" ) | telnet "$ovpn_mgmt_host" "$ovpn_mgmt_port" >/dev/null 2>&1
    return $?
  fi
  return 1
}

get_limit() {
  local user="$1"
  # pega limite do usuarios.db: "user limit"
  local lim
  lim="$(awk -v u="$user" '$1==u{print $2; exit}' "$database" 2>/dev/null)"
  [[ "$lim" =~ ^[0-9]+$ ]] || lim="1"
  echo "$lim"
}

limit_ssh() {
  local user="$1" limit="$2"
  # Conta processos sshd do usuário (mais seguro com -x)
  local conssh
  conssh="$(pgrep -u "$user" -x sshd 2>/dev/null | wc -l)"
  [[ -z "$conssh" ]] && conssh=0

  if (( conssh > limit )); then
    # Mata APENAS sshd do usuário (não todos processos)
    pkill -u "$user" -x sshd >/dev/null 2>&1
    echo "[$(date '+%d-%m-%Y %H:%M:%S')] SSH LIMIT EXCEEDED user=$user con=$conssh limit=$limit" >> "$logfile"
  fi
}

limit_openvpn() {
  local user="$1" limit="$2"

  [[ -f "$ovpn_status" ]] || return 0
  mgmt_up || return 0

  # Linhas típicas do status têm vírgula e incluem ",user,"
  local ovp
  ovp="$(grep -E ",${user}," "$ovpn_status" 2>/dev/null | wc -l)"
  [[ -z "$ovp" ]] && ovp=0

  if (( ovp > limit )); then
    local killn=$(( ovp - limit ))

    # Preferência: Real Address (campo 2) -> kill "IP:PORT"
    # Formato: Common Name,Real Address,Virtual Address,...
    local targets
    targets="$(grep -E ",${user}," "$ovpn_status" | awk -F',' '{print $2}' | head -n "$killn")"

    while read -r t; do
      [[ -z "$t" ]] && continue
      if mgmt_kill "$t"; then
        echo "[$(date '+%d-%m-%Y %H:%M:%S')] OVPN LIMIT EXCEEDED user=$user kill=$t total=$ovp limit=$limit" >> "$logfile"
      else
        # fallback: tentar matar por CN (usuário)
        if mgmt_kill "$user"; then
          echo "[$(date '+%d-%m-%Y %H:%M:%S')] OVPN LIMIT EXCEEDED user=$user kill=CN total=$ovp limit=$limit" >> "$logfile"
        fi
      fi
    done <<< "$targets"
  fi
}

fun_multilogin() {
  # usuários >=1000 (igual ao seu)
  while read -r user; do
    [[ -z "$user" ]] && continue

    local limit
    limit="$(get_limit "$user")"

    # SSH
    if id -u "$user" >/dev/null 2>&1; then
      limit_ssh "$user" "$limit"
    fi

    # OpenVPN
    limit_openvpn "$user" "$limit"
  done < <(awk -F: '$3 >= 1000 {print $1}' /etc/passwd)
}

while true; do
  fun_multilogin
  sleep "$sleep_time"
done
