#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

have(){ command -v "$1" >/dev/null 2>&1; }

fetch() { # fetch <url> <dest>
  local url="$1" dest="$2"
  if have curl; then
    curl -fsSL "$url" -o "$dest"
  else
    wget -qO "$dest" "$url"
  fi
}

fetch_stdout() { # fetch_stdout <url>
  local url="$1"
  if have curl; then
    curl -fsSL "$url"
  else
    wget -qO- "$url"
  fi
}

restart_service() {
  local svc="$1"
  systemctl restart "$svc" >/dev/null 2>&1 || service "$svc" restart >/dev/null 2>&1 || true
}

# -------------------------
# Versão e IP
# -------------------------
_lvk="$(fetch_stdout "https://raw.githubusercontent.com/PhoenixxZ2023/NEW-SSHPLUS/main/Modulos/versao" 2>/dev/null || true)"

IP="$(fetch_stdout ipv4.icanhazip.com 2>/dev/null || true)"
IP2="$(fetch_stdout http://whatismyip.akamai.com/ 2>/dev/null || true)"
[[ -n "${IP2:-}" && "${IP:-}" != "${IP2:-}" ]] && ipdovps="$IP2" || ipdovps="$IP"
echo -e "${ipdovps:-0.0.0.0}" >/etc/IP

# -------------------------
# Timezone (mantendo seu padrão)
# -------------------------
echo -e "America/Sao_Paulo" >/etc/timezone
ln -fs /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime >/dev/null 2>&1 || true
dpkg-reconfigure --frontend noninteractive tzdata >/dev/null 2>&1 || true

# -------------------------
# Diretórios
# -------------------------
mkdir -p /etc/SSHPlus/{v2ray,xray,openvpn,stunnel5,criarusuario,senha,userteste,.tmp}
mkdir -p /etc/bot/{info-users,arquivos,revenda,suspensos}
mkdir -p /etc/rec
touch /etc/SSHPlus/Exp
touch /etc/bot/lista_ativos /etc/bot/lista_suspensos

# -------------------------
# Dependências mínimas usadas aqui
# -------------------------
export DEBIAN_FRONTEND=noninteractive
apt-get update -y >/dev/null 2>&1 || true
apt-get install -y --no-install-recommends ca-certificates curl wget iproute2 net-tools procps cron jq >/dev/null 2>&1 || true

# -------------------------
# Apache: se estiver ouvindo 80 -> muda pra 81 (sem netstat)
# -------------------------
if ss -lntp 2>/dev/null | grep -qE ':80\s+.*apache2'; then
  sed -i "s/Listen 80/Listen 81/g" /etc/apache2/ports.conf >/dev/null 2>&1 || true
  restart_service apache2
fi

# -------------------------
# SSH: garantir Port 22 e PasswordAuthentication yes
# (drop-in é mais compatível com Ubuntu 22/24 e Debian 12/13)
# -------------------------
if grep -qE '^\s*#\s*Port\s+22\s*$' /etc/ssh/sshd_config 2>/dev/null; then
  sed -i 's/^\s*#\s*Port\s\+22/Port 22/' /etc/ssh/sshd_config >/dev/null 2>&1 || true
fi

mkdir -p /etc/ssh/sshd_config.d
cat >/etc/ssh/sshd_config.d/99-sshplus.conf <<'EOF'
# Managed by SSHPlus
PasswordAuthentication yes
EOF

restart_service ssh
restart_service sshd

# -------------------------
# Paths
# -------------------------
_dir1='/bin'
_dir2='/etc/SSHPlus'

# remove resíduos antigos (como você fazia)
rm -f "$_dir2/ShellBot.sh" "$_dir2/cabecalho" "$_dir2/open.py" "$_dir2/proxy.py" "$_dir2/wsproxy.py" >/dev/null 2>&1 || true

# -------------------------
# Lista completa de módulos (IGUAL À ANTIGA)
# -------------------------
_mdls=(
  "addhost" "ajuda" "alterarlimite" "alterarsenha" "apache2menu" "tcptweaker.sh" "checkers"
  "checkmanager" "utili" "multi" "check" "chuser" "limit" "rps_cpu" "attscript" "Autobackup"
  "badvpn" "banner" "bashtop" "ddos" "blocksite" "blockt" "blockuser" "bot" "botssh" "cabecalho"
  "conexao" "criarteste" "criarusuario" "delhost" "delscript" "detalhes" "droplimiter"
  "expcleaner" "fr" "infousers" "inst-botteste" "initcheck" "instsqd" "limiter" "mainproxy"
  "menu" "menub" "menuudp" "mudardata" "mtuning" "multi" "onlineapp" "openvpn.sh" "open.py"
  "otimizar" "painelv2ray" "prissh" "prnet.sh" "proxydt" "proxy.py" "reiniciarservicos"
  "reiniciarsistema" "remover" "rustyproxy" "security" "senharoot" "ShellBot.sh" "slowdns"
  "slow_dns" "speedtest" "sshmonitor" "suspenderusuario.sh" "stunnel5" "swapmemory"
  "trafegototal" "trojan-go" "uexpired" "userbackup" "velocity" "verifatt" "verifbot"
  "v2raymanager" "v2ray" "xray" "xraymanager" "webmin.sh" "websocket.sh" "wsproxy.py" "pkill.sh"
)

# -------------------------
# Baixar módulos para /bin (mantendo seu padrão)
# -------------------------
for _arq in "${_mdls[@]}"; do
  rm -f "${_dir1}/${_arq}" >/dev/null 2>&1 || true

  fetch "https://raw.githubusercontent.com/PhoenixxZ2023/NEW-SSHPLUS/main/Modulos/${_arq}" "${_dir1}/${_arq}" \
    || { echo "Falha ao baixar: ${_arq}"; exit 1; }

  chmod 755 "${_dir1}/${_arq}"
done

# mover alguns para /etc/SSHPlus como antes
mv -f "${_dir1}/cabecalho" "${_dir1}/bot" "${_dir1}/open.py" "${_dir1}/proxy.py" "${_dir1}/wsproxy.py" "${_dir2}/" \
  >/dev/null 2>&1 || true

# -------------------------
# (Mantido) /etc/hosts - OBS: eu mantive, mas isso é invasivo.
# -------------------------
_arq_host="/etc/hosts"
_host=(
  "d1n212ccp6ldpw.cloudfront.net"
  "dns.whatsapp.net"
  "portalrecarga.vivo.com.br/recarga"
  "navegue.vivo.com.br/controle/"
  "navegue.vivo.com.br/pre/"
  "www.whatsapp.net"
  "/SSHPLUS?"
)
for host in "${_host[@]}"; do
  if [[ "$(grep -w "$host" "$_arq_host" 2>/dev/null | wc -l)" = "0" ]]; then
    sed -i "3i\127.0.0.1 $host" "$_arq_host" >/dev/null 2>&1 || true
  fi
done

# -------------------------
# Autostart (sem cron a cada minuto)
# -------------------------
if [[ ! -e /etc/autostart ]]; then
  cat >/etc/autostart <<'EOF'
#!/bin/bash
clear
# INICIO AUTOMATICO
EOF
  chmod 755 /etc/autostart
else
  # limpa screens antigas como você fazia
  for proc in $(ps x | grep 'dmS' | grep -v 'grep' | awk '{print $1}'); do
    screen -r -S "$proc" -X quit >/dev/null 2>&1 || true
  done
  screen -wipe >/dev/null 2>&1 || true

  cat >/etc/autostart <<'EOF'
#!/bin/bash
clear
# INICIO AUTOMATICO
EOF
  chmod 755 /etc/autostart
fi

# -------------------------
# Cron (mantendo suas tarefas essenciais, removendo o "* * * * * /etc/autostart")
# -------------------------
crontab -r >/dev/null 2>&1 || true
(
  crontab -l 2>/dev/null || true
  echo "@daily /bin/verifatt"
  echo "@reboot /etc/autostart"
  echo "0 */6 * * * /bin/uexpired"
) | crontab -

# -------------------------
# Versão
# -------------------------
echo "${_lvk:-unknown}" >/bin/versao
cat /bin/versao > /home/sshplus 2>/dev/null || true

# -------------------------
# /opt/sshplus (mantido)
# -------------------------
mkdir -p /opt/sshplus
: > /opt/sshplus/sshplus

# -------------------------
# /etc/SSHPlus extras (WebSocket/mainproxy/security/proxydt + keys) - mantido e corrigido
# -------------------------
cd /etc/SSHPlus/

# WebSocket + keys
fetch "https://raw.githubusercontent.com/PhoenixxZ2023/NEW-SSHPLUS/main/Modulos/WebSocket" "WebSocket"
fetch "https://raw.githubusercontent.com/PhoenixxZ2023/NEW-SSHPLUS/main/Modulos/pub.key" "pub.key"
fetch "https://raw.githubusercontent.com/PhoenixxZ2023/PLUS/main/Modulos/priv.pem" "priv.pem"
chmod 755 WebSocket
chmod 644 pub.key
chmod 600 priv.pem

# mainproxy
fetch "https://raw.githubusercontent.com/PhoenixxZ2023/NEW-SSHPLUS/main/Modulos/mainproxy" "mainproxy"
chmod 755 mainproxy

# security + keys
fetch "https://raw.githubusercontent.com/PhoenixxZ2023/NEW-SSHPLUS/main/Install/security" "security"
fetch "https://raw.githubusercontent.com/PhoenixxZ2023/NEW-SSHPLUS/main/Install/pub.key" "security.pub.key"
fetch "https://raw.githubusercontent.com/PhoenixxZ2023/NEW-SSHPLUS/main/Install/priv.pem" "security.priv.pem"
chmod 755 security
chmod 644 security.pub.key
chmod 600 security.priv.pem

# proxydt
fetch "https://raw.githubusercontent.com/PhoenixxZ2023/NEW-SSHPLUS/main/Install/proxydt" "proxydt"
chmod 755 proxydt

cd "$HOME"

# -------------------------
# usuarios.db (corrigido - UID>=1000 e awk correto)
# (se você quiser manter opção de "preservar", isso fica no Plus; aqui só garante existir)
# -------------------------
if [[ ! -f "$HOME/usuarios.db" ]]; then
  awk -F: '$3>=1000 {print $1 " 1"}' /etc/passwd | grep -Ev '^(nobody|ubuntu|lxd)$' > "$HOME/usuarios.db"
fi

# -------------------------
# Restart serviços
# -------------------------
restart_service cron
restart_service ssh
restart_service sshd
[[ -d /var/www/html/openvpn ]] && restart_service apache2

exit 0
