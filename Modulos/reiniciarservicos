#!/bin/bash
set -euo pipefail

# -------- helpers --------
have() { command -v "$1" >/dev/null 2>&1; }

# chama menu com segurança (se existir)
go_menu() {
  if declare -F menu >/dev/null 2>&1; then
    menu
  elif command -v menu >/dev/null 2>&1; then
    menu
  else
    exit 0
  fi
}

list_listen_ports_by_proc() {
  # args: regex_proc
  local re="$1"
  if have ss; then
    ss -lntp 2>/dev/null | grep -E "$re" | awk '{print $4}' | awk -F: '{print $NF}' | xargs
  elif have netstat; then
    netstat -nltp 2>/dev/null | grep -E "$re" | awk '{print $4}' | awk -F: '{print $NF}' | xargs
  else
    echo ""
  fi
}

is_running_proc() {
  local re="$1"
  ps ax 2>/dev/null | grep -E "$re" | grep -v grep >/dev/null 2>&1
}

restart_svc() {
  # args: service_name
  local s="$1"
  if have systemctl && systemctl list-unit-files 2>/dev/null | grep -q "^${s}\.service"; then
    systemctl restart "$s" >/dev/null 2>&1 || true
    return
  fi
  if have service; then
    service "$s" restart >/dev/null 2>&1 || true
    return
  fi
  [[ -x "/etc/init.d/$s" ]] && "/etc/init.d/$s" restart >/dev/null 2>&1 || true
}

title() {
  tput setaf 7; tput setab 4; tput bold
  printf '%35s\n' "  REINICIAR SERVIÇOS  "
  tput sgr0
}

status_line() {
  # args: label ports
  local label="$1" ports="$2"
  printf "%b┃%bSERVICO:%b %-22s %bPORTA:%b %s\n" \
    "\033[1;31m" "\033[1;32m" "\033[1;33m" "$label" "\033[1;32m" "\033[1;37m" "${ports:-"-"}"
}

# -------- detect --------
clear
title
echo ""

# OPENSSH
SSH_PORTS="$(grep -E '^[[:space:]]*Port[[:space:]]+' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | grep -v '^#' | xargs || true)"
status_line "OPENSSH" "$SSH_PORTS"

# SLOWDNS
if is_running_proc 'slowdns'; then
  status_line "SLOWDNS" "$(list_listen_ports_by_proc 'slowdns')"
fi

# SSLH
if is_running_proc 'sslh'; then
  status_line "SSLH" "$(list_listen_ports_by_proc 'sslh')"
fi

# OPENVPN
if is_running_proc 'openvpn'; then
  status_line "OPENVPN" "$(list_listen_ports_by_proc 'openvpn')"
fi

# WEBSOCKET (antigo)
if is_running_proc 'WebSocket'; then
  ws_port="$(cat /etc/mamalista 2>/dev/null | xargs || true)"
  status_line "WEBSOCKET SECURITY" "${ws_port:-$(list_listen_ports_by_proc 'WebSocket')}"
fi

# WEBSOCKET V2
if is_running_proc 'security'; then
  status_line "WEBSOCKET SECURITY V2.0" "$(list_listen_ports_by_proc 'security')"
fi

# PROXY (/proxy)
PROXY_PORTS=""
if have ss; then
  PROXY_PORTS="$(ss -lntp 2>/dev/null | grep -E '/proxy( |$)' | awk '{print $4}' | awk -F: '{print $NF}' | xargs || true)"
elif have netstat; then
  PROXY_PORTS="$(netstat -nltp 2>/dev/null | grep -E '/proxy( |$)' | awk '{print $4}' | awk -F: '{print $NF}' | xargs || true)"
fi
if [[ -n "${PROXY_PORTS:-}" ]]; then
  status_line "PROXY" "$PROXY_PORTS"
fi

# PROXY DTUNNEL
if is_running_proc 'proxydt'; then
  status_line "PROXY DTUNNEL MOD" "$(list_listen_ports_by_proc 'proxydt')"
fi

# DRAGONX (systemd)
if have systemctl && systemctl list-units --type=service --state=running 2>/dev/null | grep -q 'dragonx'; then
  status_line "DRAGONX PROXY" "$(list_listen_ports_by_proc 'dragonx')"
fi

# PYTHON3 SOCKS/PROXY (filtrado)
PY_PORTS=""
if have ss; then
  PY_PORTS="$(ss -lntp 2>/dev/null | grep -E 'python3' | grep -E 'proxy|socks|ws|security|proxydt|dragonx' | awk '{print $4}' | awk -F: '{print $NF}' | xargs || true)"
elif have netstat; then
  PY_PORTS="$(netstat -nltp 2>/dev/null | grep -E 'python3' | grep -E 'proxy|socks|ws|security|proxydt|dragonx' | awk '{print $4}' | awk -F: '{print $NF}' | xargs || true)"
fi
if [[ -n "${PY_PORTS:-}" ]]; then
  status_line "PYTHON3 (SOCKS/PROXY)" "$PY_PORTS"
fi

# STUNNEL4
if [[ -f /etc/stunnel/stunnel.conf ]]; then
  status_line "SSL STUNNEL4" "$(list_listen_ports_by_proc 'stunnel')"
fi

# STUNNEL5
if [[ -f /usr/local/etc/stunnel/stunnel.conf ]]; then
  status_line "SSL STUNNEL5" "$(list_listen_ports_by_proc 'stunnel5|stunnel')"
fi

# DROPBEAR
if is_running_proc 'dropbear'; then
  status_line "DROPBEAR" "$(list_listen_ports_by_proc 'dropbear')"
fi

echo ""
echo -ne "\033[1;32mREINICIAR AGORA TODOS OS SERVIÇOS DETECTADOS? \033[1;33m[s/n]\033[1;37m: "
read -r resp

if [[ "${resp,,}" != "s" ]]; then
  echo -e "\n\033[1;33mRETORNANDO AO MENU...\033[0m"
  sleep 1
  go_menu
fi

# -------- restart --------
echo -e "\n\033[1;33mREINICIANDO...\033[0m"

restart_svc ssh || restart_svc sshd
restart_svc dropbear
restart_svc openvpn
restart_svc sslh
restart_svc squid || restart_svc squid3
restart_svc stunnel4
restart_svc stunnel5
restart_svc dragonx

# proxy (se existir unit). Se não existir, tenta matar processo /proxy (fallback)
if have systemctl && systemctl list-unit-files 2>/dev/null | grep -q '^proxy\.service'; then
  restart_svc proxy
else
  if is_running_proc '/proxy( |$)'; then
    pkill -f '/proxy( |$)' >/dev/null 2>&1 || true
    # se você tiver o comando exato de start do proxy, coloque aqui
    # /usr/local/bin/proxy ... &
  fi
fi

echo -e "\n\033[1;32mSERVIÇOS REINICIADOS COM SUCESSO!\033[0m"
echo -ne "\n\033[1;37m• \033[1;33mENTER PARA RETORNAR AO MENU!\033[0m"
read -r _
go_menu
