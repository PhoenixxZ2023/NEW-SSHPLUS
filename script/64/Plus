# ----------- .bashrc (sem duplicar) -----------
setup_bashrc_banner() {
  local rc="/root/.bashrc"
  local start="# >>> NEW-SSHPLUS BANNER >>>"
  local end="# <<< NEW-SSHPLUS BANNER <<<"

  # remove bloco antigo
  if grep -qF "$start" "$rc" 2>/dev/null; then
    awk -v s="$start" -v e="$end" '
      $0==s {inblk=1; next}
      $0==e {inblk=0; next}
      !inblk {print}
    ' "$rc" > "${rc}.tmp" && mv "${rc}.tmp" "$rc"
  fi

  cat >> "$rc" <<'EOF'
# >>> NEW-SSHPLUS BANNER >>>
clear
toilet -f smblock -F metal           "NEW  SSHPLUS  2025"
echo -e "\033[1;36m💻 NOME DO SERVIDOR : $HOSTNAME\033[0m"
