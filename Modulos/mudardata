#!/bin/bash
# mudardata.sh - MUDAR DATA DE EXPIRAÇÃO (SSHPlus)
# Ajuste: recalcula /etc/SSHPlus/Exp ao final (contador de vencidos correto)
# Sem ui.sh / sem dependências extras.

set -u
shopt -s extglob

# ====== ESTILO (MAIÚSCULO + “NEGRITO” via códigos ANSI) ======
BOLD="\033[1m"
RESET="\033[0m"
BLUE="\033[1;34m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
WHITE="\033[1;37m"

ttl()  { echo -e "${BLUE}${BOLD}${*^^}${RESET}"; }
ok()   { echo -e "${GREEN}${BOLD}${*^^}${RESET}"; }
warn() { echo -e "${YELLOW}${BOLD}${*^^}${RESET}"; }
err()  { echo -e "${RED}${BOLD}${*^^}${RESET}"; }

# ====== RECALCULA EXPIRADOS (contador /etc/SSHPlus/Exp) ======
recalc_expired_list() {
  local EXP_FILE="/etc/SSHPlus/Exp"
  mkdir -p "$(dirname "$EXP_FILE")" >/dev/null 2>&1 || true
  : > "$EXP_FILE" 2>/dev/null || true

  while IFS=: read -r u _ uid _ _ _ _; do
    [[ "$uid" -ge 1000 ]] || continue
    [[ "$u" =~ ^(nobody|ubuntu|lxd)$ ]] && continue

    local exp_line exp_epoch
    exp_line="$(chage -l "$u" 2>/dev/null | awk -F': ' '/^Account expires/ {print $2; exit}')"
    [[ -z "${exp_line:-}" || "$exp_line" == "never" ]] && continue

    exp_epoch="$(date -d "$exp_line" +%s 2>/dev/null || echo 0)"
    [[ "$exp_epoch" -eq 0 ]] && continue

    if (( exp_epoch < $(date +%s) )); then
      echo "$u" >> "$EXP_FILE"
    fi
  done < /etc/passwd
}

# ====== TELA ======
clear
ttl "MUDAR DATA DE EXPIRAÇÃO"
echo ""
warn "LISTA DE USUÁRIOS E DATA DE EXPIRAÇÃO:"
echo ""

list_user="$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -Ev '^(nobody|ubuntu|lxd)$')"

i=0
unset _userPass

# imprime lista formatada
while read -r user; do
  [[ -z "${user:-}" ]] && continue
  i=$((i + 1))
  _oP="$i"
  [[ "$i" == [1-9] ]] && i="0$i" && oP+=" 0$i"

  expire="$(chage -l "$user" 2>/dev/null | awk -F': ' '/^Account expires/ {print $2; exit}')"
  if [[ -z "${expire:-}" ]]; then
    expire="never"
  fi

  if [[ "$expire" == "never" ]]; then
    echo -e "${RED}[${YELLOW}${i}${RED}] ${WHITE}- ${GREEN}${user}${WHITE}     ${YELLOW}00/00/0000   ${WHITE}S/DATA${RESET}"
  else
    databr="$(date -d "$expire" +"%Y%m%d" 2>/dev/null || echo 0)"
    hoje="$(date -d today +"%Y%m%d")"
    if [[ "$databr" == 0 ]]; then
      # fallback: se parse falhar, mostra bruto
      _user_fmt="${RED}[${YELLOW}${i}${RED}] ${WHITE}- ${GREEN}${user}${WHITE}"
      datanormal="${YELLOW}${expire}${RESET}"
      status="${YELLOW}DATA DESCONHECIDA${RESET}"
      printf '%-62b%-20b%b\n' "$_user_fmt" "$datanormal" "$status"
    elif (( hoje >= databr )); then
      _user_fmt="${RED}[${YELLOW}${i}${RED}] ${WHITE}- ${GREEN}${user}${WHITE}"
      datanormal="${RED}$(date -d "$expire" '+%d/%m/%Y' 2>/dev/null)${RESET}"
      expired="${RED}VENCEU${RESET}"
      printf '%-62b%-20b%b\n' "$_user_fmt" "$datanormal" "$expired"
    else
      _user_fmt="${RED}[${YELLOW}${i}${RED}] ${WHITE}- ${GREEN}${user}${WHITE}"
      datanormal="${YELLOW}$(date -d "$expire" '+%d/%m/%Y' 2>/dev/null)${RESET}"
      active="${GREEN}VALIDO${RESET}"
      printf '%-62b%-20b%b\n' "$_user_fmt" "$datanormal" "$active"
    fi
  fi

  _userPass+="\n${_oP}:${user}"
done <<< "$list_user"

echo ""
num_user="$(echo "$list_user" | wc -l)"

echo -ne "${GREEN}${BOLD}DIGITE OU SELECIONE UM USUÁRIO ${YELLOW}[${WHITE}1${YELLOW}-${WHITE}${num_user}${YELLOW}]${WHITE}: ${RESET}"
read -r option

if [[ -z "${option:-}" ]]; then
  echo ""
  err "ERRO: OPÇÃO VAZIA OU INVÁLIDA!"
  echo ""
  exit 1
fi

usuario="$(echo -e "$_userPass" | grep -E "\b${option}\b" | cut -d: -f2)"

if [[ -z "${usuario:-}" ]]; then
  echo ""
  err "ERRO: USUÁRIO VAZIO OU INVÁLIDO!"
  echo ""
  exit 1
fi

if ! id "$usuario" >/dev/null 2>&1; then
  echo ""
  err "ERRO: O USUÁRIO ${usuario} NÃO EXISTE!"
  echo ""
  exit 1
fi

echo ""
warn "EXEMPLO: (DATA: DIA/MÊS/ANO OU DIAS: 30)"
echo ""
echo -ne "${GREEN}${BOLD}NOVA DATA OU DIAS PARA O USUÁRIO ${YELLOW}${usuario}${WHITE}: ${RESET}"
read -r inputdate

if [[ -z "${inputdate:-}" ]]; then
  echo ""
  err "ERRO: VOCÊ DIGITOU UMA DATA/DIAS INVÁLIDOS!"
  echo ""
  exit 1
fi

# converte entrada -> sysdate (YYYY-MM-DD) e udata (DD/MM/YYYY)
if [[ "$(echo -e "$inputdate" | grep -c "/")" = "0" ]]; then
  # dias
  if ! [[ "$inputdate" =~ ^[0-9]+$ ]]; then
    echo ""
    err "ERRO: DIAS INVÁLIDOS! USE SOMENTE NÚMEROS."
    echo ""
    exit 1
  fi
  udata="$(date "+%d/%m/%Y" -d "+${inputdate} days" 2>/dev/null || true)"
  sysdate="$(echo "$udata" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')"
else
  # data dd/mm/yyyy
  udata="$inputdate"
  sysdate="$(echo "$inputdate" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')"
fi

# valida sysdate
if ! date "+%Y-%m-%d" -d "$sysdate" >/dev/null 2>&1; then
  echo ""
  err "ERRO: DATA INVÁLIDA OU INEXISTENTE! USE DIA/MÊS/ANO."
  echo ""
  exit 1
fi

# bloqueia data passada ou hoje
today_ymd="$(date -d today +"%Y%m%d")"
target_ymd="$(date -d "$sysdate" +"%Y%m%d" 2>/dev/null || echo 0)"

if [[ "$target_ymd" == 0 || "$today_ymd" -ge "$target_ymd" ]]; then
  echo ""
  err "ERRO: DIGITE UMA DATA FUTURA (NÃO PODE SER HOJE/PASSADO)!"
  echo ""
  exit 1
fi

# aplica expiração
chage -E "$sysdate" "$usuario" >/dev/null 2>&1

# atualiza lista de expirados (contador)
recalc_expired_list

echo ""
ok "SUCESSO! USUÁRIO ${usuario} NOVA DATA: ${udata}"
echo ""
exit 0
