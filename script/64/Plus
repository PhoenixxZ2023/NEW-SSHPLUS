# Helpers
have() { command -v "$1" >/dev/null 2>&1; }

fetch() {
  # fetch <url> <dest>
  local url="$1" dest="$2"
  if have curl; then
    curl -fsSL "$url" -o "$dest"
  else
    wget -qO "$dest" "$url"
  fi
}

run_tmp_script() {
  # run_tmp_script <url> [args...]
  local url="$1"; shift || true
  local tmpdir; tmpdir="$(mktemp -d)"
  local f="${tmpdir}/script.sh"
  trap 'rm -rf "$tmpdir"' RETURN
  fetch "$url" "$f" || die "Falha ao baixar: $url"
  chmod 700 "$f"
  bash "$f" "$@"
}

