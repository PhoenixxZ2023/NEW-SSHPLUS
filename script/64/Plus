  while true; do
    for ((i=0; i<18; i++)); do
      echo -ne "\033[1;92m■"
      sleep 0.1
    done
    if [[ -e "$HOME/fim" ]]; then
      rm -f "$HOME/fim" && break
    fi
    echo -e "\033[1;93m]"
    sleep 0.4
    tput cuu1
    tput dl1
