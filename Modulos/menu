#!/bin/bash

# ==========================================
# MENU SSHPLUS (FINAL) - com checagem segura
# - Menu principal + Submenu (menu2)
# - Checa dependências e comandos/funções
# - RAM real e CPU via /proc/stat
# ==========================================

set +e

IP="$(cat /etc/IP 2>/dev/null || wget -qO- ipv4.icanhazip.com 2>/dev/null)"
x=""

# ----------------------------
# Helpers de segurança / UX
# ----------------------------

cmd_exists() {
  command -v "$1" >/dev/null 2>&1
}

func_exists() {
  declare -F "$1" >/dev/null 2>&1
}

show_msg() {
  # $1 = cor (32/31/33), $2 = mensagem
  echo -e "\n\033[1;${1}m${2}\033[0m"
}

press_enter() {
  echo -ne "\n\033[1;31mENTER \033[1;33mpara retornar!\033[0m"
  read
}

need_cmd() {
  # uso: need_cmd speedtest || return 1
  local c="$1"
  if ! cmd_exists "$c"; then
    show_msg 31 "Comando '$c' não instalado!"
    return 1
  fi
  return 0
}

# Executa comando/função se existir (função bash ou binário externo)
# Ex.: run_safe criarusuario
#      run_safe tcptweaker.sh
run_safe() {
  local target="$1"

  if func_exists "$target"; then
    "$target"
    return $?
  fi

  if cmd_exists "$target"; then
    "$target"
    return $?
  fi

  show_msg 31 "Comando/Função '$target' não encontrado(a)!"
  return 127
}

# Executa string shell com mensagem de erro amigável
run_sh_safe() {
  local desc="$1"
  local shcmd="$2"
  bash -c "$shcmd"
  local rc=$?
  if [[ $rc -ne 0 ]]; then
    show_msg 31 "Falha ao executar: ${desc}"
  fi
  return $rc
}

fun_bar () {
  comando[0]="$1"
  comando[1]="${2:-sleep 1}"
  (
    [[ -e "$HOME/fim" ]] && rm -f "$HOME/fim"
    bash -c "${comando[0]}" >/dev/null 2>&1
    bash -c "${comando[1]}" >/dev/null 2>&1
    touch "$HOME/fim"
  ) >/dev/null 2>&1 &
  tput civis
  echo -ne "\033[1;37m["
  while true; do
    for ((i=0; i<18; i++)); do
      echo -ne "\033[1;31m#"
      sleep 0.1
    done
    [[ -e "$HOME/fim" ]] && rm -f "$HOME/fim" && break
    echo -e "\033[1;37m]"
    sleep 1
    tput cuu1
    tput dl1
    echo -ne "\033[1;37m["
  done
  echo -e "\033[1;37m]\033[1;37m -\033[1;32m OK !\033[1;37m"
  tput cnorm
}

cpu_usage() {
  local t1 i1 t2 i2
  t1=$(awk '/^cpu /{for(i=2;i<=8;i++) s+=$i; print s}' /proc/stat)
  i1=$(awk '/^cpu /{print $5}' /proc/stat)
  sleep 0.2
  t2=$(awk '/^cpu /{for(i=2;i<=8;i++) s+=$i; print s}' /proc/stat)
  i2=$(awk '/^cpu /{print $5}' /proc/stat)
  awk -v t1="$t1" -v t2="$t2" -v i1="$i1" -v i2="$i2" \
    'BEGIN{dt=t2-t1; di=i2-i1; if(dt<=0) printf "0.0%%"; else printf "%.1f%%", (100*(dt-di)/dt)}'
}

sys_line() {
  printf '%-15s' "$(lsb_release -si 2>/dev/null || echo 'Linux') $(lsb_release -sr 2>/dev/null || echo '')"
}

calc_status() {
  _system="$(sys_line)"
  _hora="$(printf '%(%H:%M:%S)T')"
  _core="$(printf '%-6s' "$(grep -cE '^cpu[0-9]+' /proc/stat 2>/dev/null)")"

  _ons=$(ps -x | grep sshd | grep -v root | grep priv | wc -l)
  [[ -e /etc/openvpn/openvpn-status.log ]] && _onop=$(grep -c "10.8.0" /etc/openvpn/openvpn-status.log) || _onop="0"
  [[ -e /etc/default/dropbear ]] && _drp=$(ps aux | grep dropbear | grep -v grep | wc -l) && _ondrp=$((_drp - 1)) || _ondrp="0"
  [[ "$_ondrp" -lt 0 ]] && _ondrp=0
  _onli=$((_ons + _onop + _ondrp))
  _onlin="$(printf '%-5s' "$_onli")"

  [[ -s /etc/SSHPlus/Exp ]] && _expuser="$(cat /etc/SSHPlus/Exp 2>/dev/null)" || _expuser="0"
  _userexp="$(printf '%-5s' "$_expuser")"

  _tuser="$(printf '%-5s' "$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -Ev '^(nobody|ubuntu|lxd)$' | wc -l)")"

  _ram_total=$(free -m | awk '/^Mem:/ {print $2}')
  _ram_used=$(free -m | awk '/^Mem:/ {u=$3-$6-$7; if(u<0) u=0; print u}')
  _ram_total_gi=$(awk -v t="$_ram_total" 'BEGIN{printf "%.2f", t/1024}')
  _usor="$(printf '%-8s' "$(awk -v u="$_ram_used" -v t="$_ram_total" 'BEGIN{if(t>0) printf "%.2f%%", (u/t)*100; else printf "0.00%%"}')")"
  _ram="$(printf '%-9s' "${_ram_total_gi}Gi")"

  _usop="$(printf '%-6s' "$(cpu_usage)")"

  swap1="$(printf '%-5s' "$(free -h | awk '/^Swap:/ {print $2}')")"
  swap2="$(printf '%-5s' "$(free -h | awk '/^Swap:/ {print $4}')")"
  swap3="$(printf '%-5s' "$(free -h | awk '/^Swap:/ {print $3}')")"

  stsbot=$(pgrep -f "bot_plus" >/dev/null 2>&1 && echo -e "\033[0;92m⬤ " || echo -e "\033[0;31m⬤ ")
  stsl=$(pgrep -f "limiter"  >/dev/null 2>&1 && echo -e "\033[0;93m⬤ " || echo -e "\033[0;31m⬤ ")
  stsu=$(pgrep -f "udpvpn"   >/dev/null 2>&1 && echo -e "\033[0;93m⬤ " || echo -e "\033[0;31m⬤ ")
  stsbotteste=$(ps x | grep "bot_teste" | grep -v grep >/dev/null 2>&1 && echo -e "\033[0;92m⬤ " || echo -e "\033[0;31m⬤ ")
  autm=$(grep "menu;" /etc/profile >/dev/null 2>&1 && echo -e "\033[0;92m⬤ " || echo -e "\033[0;31m⬤ ")
}

velocity () {
  local SPEED_FILE="$HOME/speed"
  local png="" down="" upl="" lnk=""

  clear
  echo -e "\E[38;5;18m╭━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╮\033[0m"
  echo -e "\E[38;5;18m┃\E[44;1;37m    TESTANDO A VELOCIDADE DO SERVIDOR    \E[0m\E[38;5;18m┃"
  echo -e "\E[38;5;18m╰━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╯\033[0m"
  echo ""

  rm -f "$SPEED_FILE"

  # ----------------------------
  # Executa speedtest (sem aguarde/fun_bar)
  # ----------------------------
  echo -ne "\033[1;37mAGUARDE \033[1;33mexecutando speedtest...\033[0m"

  if cmd_exists speedtest; then
    # Tenta Ookla com flags modernas; se falhar, tenta modo legado
    (
      speedtest --accept-license --accept-gdpr --format=human-readable > "$SPEED_FILE" 2>&1 \
      || speedtest --secure --share > "$SPEED_FILE" 2>&1
    )
  elif cmd_exists speedtest-cli; then
    (
      speedtest-cli --share --secure > "$SPEED_FILE" 2>&1 \
      || speedtest-cli --share > "$SPEED_FILE" 2>&1
    )
  else
    echo ""
    echo -e "\n\033[1;31mComando speedtest não instalado!\033[0m"
    echo -e "\033[1;33mInstale um destes:\033[0m"
    echo -e "\033[1;37m - apt install speedtest-cli -y\033[0m"
    echo -e "\033[1;37m - (ou) speedtest oficial da Ookla\033[0m"
    press_enter
    return 1
  fi

  echo -e " \033[1;32mOK!\033[0m"

  if [[ ! -s "$SPEED_FILE" ]]; then
    echo -e "\n\033[1;31mFalha ao gerar resultado do speedtest.\033[0m"
    press_enter
    return 1
  fi

  # Se houve erro textual (sem resultados)
  if grep -qiE 'error|cannot|failed|permission|denied|timeout|exception' "$SPEED_FILE"; then
    # Se mesmo assim existir download/upload, segue
    if ! grep -qiE 'Download:|Upload:' "$SPEED_FILE"; then
      clear
      echo -e "\n\033[1;31mSpeedtest retornou erro no servidor.\033[0m"
      echo -e "\033[1;33mSaída detectada:\033[0m"
      head -n 8 "$SPEED_FILE"
      press_enter
      rm -f "$SPEED_FILE"
      return 1
    fi
  fi

  # ----------------------------
  # Parse robusto (Ookla + speedtest-cli)
  # ----------------------------
  png=$(grep -im1 -E '(^[[:space:]]*Ping:|Latency:|latency:)' "$SPEED_FILE" | sed 's/^[[:space:]]*//')
  [[ -z "$png" ]] && png=$(grep -im1 -E 'Server:|Hosted by' "$SPEED_FILE" | sed 's/^[[:space:]]*//')
  [[ -z "$png" ]] && png="N/D"

  down=$(grep -im1 -E '^[[:space:]]*Download:' "$SPEED_FILE" | sed 's/^[[:space:]]*//')
  [[ -z "$down" ]] && down=$(grep -im1 -E 'Download[[:space:]]speed:' "$SPEED_FILE" | sed 's/^[[:space:]]*//')
  [[ -z "$down" ]] && down="N/D"

  upl=$(grep -im1 -E '^[[:space:]]*Upload:' "$SPEED_FILE" | sed 's/^[[:space:]]*//')
  [[ -z "$upl" ]] && upl=$(grep -im1 -E 'Upload[[:space:]]speed:' "$SPEED_FILE" | sed 's/^[[:space:]]*//')
  [[ -z "$upl" ]] && upl="N/D"

  lnk=$(grep -Eo 'https?://[^[:space:]]+' "$SPEED_FILE" | tail -n1)
  [[ -z "$lnk" ]] && lnk="N/D"

  # Fallback legado (linhas fixas)
  if [[ "$down" == "N/D" && "$upl" == "N/D" ]]; then
    local _png _down _upl _lnk
    _png=$(sed -n '5p' "$SPEED_FILE" | awk -F: '{print $NF}')
    _down=$(sed -n '7p' "$SPEED_FILE" | awk -F: '{print $NF}')
    _upl=$(sed -n '9p' "$SPEED_FILE" | awk -F: '{print $NF}')
    _lnk=$(sed -n '10p' "$SPEED_FILE" | awk '{print $NF}')
    [[ -n "$_png" ]] && png="$_png"
    [[ -n "$_down" ]] && down="$_down"
    [[ -n "$_upl" ]] && upl="$_upl"
    [[ -n "$_lnk" ]] && lnk="$_lnk"
  fi

  clear
  echo -e "\E[38;5;18m╭━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╮\033[0m"
  echo -e "\E[38;5;18m┃\E[44;1;37m    TESTANDO A VELOCIDADE DO SERVIDOR    \E[0m\E[38;5;18m┃"
  echo -e "\E[38;5;18m╰━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╯\033[0m"
  echo ""
  echo -e "\E[38;5;18m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
  echo -e "\033[1;32mPING (LATENCIA):\033[1;37m $png"
  echo -e "\033[1;32mDOWNLOAD:\033[1;37m $down"
  echo -e "\033[1;32mUPLOAD:\033[1;37m $upl"
  echo -e "\033[1;32mLINK:\033[1;37m \E[38;5;33m$lnk"
  echo -e "\E[38;5;18m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"

  rm -f "$SPEED_FILE"
}

limit1 () {
  clear
  echo -e "\n\033[1;32mINICIANDO O LIMITER... \033[0m\n"

  if ! need_cmd screen; then
    show_msg 33 "Instale com: apt install screen -y"
    sleep 2
    return 1
  fi

  fun_bar 'screen -dmS limiter limiter' 'sleep 2'
  sed -i '/limiter/d' /etc/autostart 2>/dev/null
  echo "ps x | grep 'limiter' | grep -v 'grep' && echo 'ON' || screen -dmS limiter limiter" >> /etc/autostart
  echo -e "\n\033[1;32m  LIMITER ATIVO !\033[0m"
  sleep 2
}

limit2 () {
  clear
  echo -e "\033[1;32mPARANDO O LIMITER... \033[0m\n"

  if ! need_cmd screen; then
    show_msg 33 "Instale com: apt install screen -y"
    sleep 2
    return 1
  fi

  fun_bar 'screen -r -S "limiter" -X quit 2>/dev/null; screen -wipe >/dev/null 2>&1; sed -i "/limiter/d" /etc/autostart 2>/dev/null' 'sleep 2'
  echo -e "\n\033[1;31m LIMITER PARADO !\033[0m"
  sleep 2
}

limit_ssh () {
  pgrep -f "limiter" >/dev/null 2>&1 && limit2 || limit1
}

autoexec () {
  if grep -q "menu;" /etc/profile 2>/dev/null; then
    clear
    echo -e "\033[1;32mDesativando auto execução\033[0m\n"
    fun_bar "sed -i '/menu;/d' /etc/profile" "sleep 1"
    echo -e "\n\033[1;31mAuto execução desativado!\033[0m"
    sleep 1.5
  else
    clear
    echo -e "\033[1;32mAtivando auto execução\033[0m\n"
    fun_bar "grep -v '^menu;' /etc/profile > /tmp/tmpass && mv /tmp/tmpass /etc/profile && echo 'menu;' >> /etc/profile" "sleep 1"
    echo -e "\n\033[1;32mAuto execução ativado!\033[0m"
    sleep 1.5
  fi
}

